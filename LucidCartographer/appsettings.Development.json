{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Error"
    }
  },
  "Database": {
    "Path": "data/cartographer.db"
  },
  "Auth": {
    "BypassLocalAddresses": true,
    "TrustedProxies": [
      "127.0.0.1",
      "::1"
    ]
  },
  "Enrichment": {
    "Concurrency": 3,
    "MaxConcurrentPages": 3,
    "BatchSize": 12,
    "IdlePollSeconds": 15,
    "MaxRetries": 5,
    "BackoffBaseSeconds": 15,
    "Headed": true,
    "SlowMoMs": 250
  }
}
