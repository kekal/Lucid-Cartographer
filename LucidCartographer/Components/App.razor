<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <meta name="description" content="Lucid Cartographer - a personal geospatial POI management tool for organizing, importing, and visualizing location data." />
    <link rel="icon" href="favicon.png" />
    <link rel="manifest" href="manifest.json" />
    <link rel="stylesheet" href="css/tailwind.css" />
    <!-- ARCH-HIGH-07: Google Fonts loaded from CDN — lower risk than JS CDNs since CSS cannot
         execute code. SRI hashes are impractical here because Google Fonts serves different
         CSS per user-agent. TODO: Self-host fonts for full CDN independence if needed. -->
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <!-- ARCH-HIGH-07: Self-hosted Leaflet 1.9.4 (previously loaded from unpkg CDN) -->
    <link rel="stylesheet" href="lib/leaflet/leaflet.css" />
    <script src="lib/leaflet/leaflet.js"></script>
    <link rel="stylesheet" href="css/base.css?v=2" />
    @* Scoped-CSS bundle (LucidCartographer.styles.css) intentionally omitted:
       no .razor.css files exist in the project, so the bundle is never generated
       and the link would 404 on every page load. Re-add if component-scoped CSS
       is introduced later. *@
    <HeadOutlet />
</head>
<body class="font-body text-on-surface bg-surface">
    <Routes />
    <!-- MED-08: downloadFile moved into leafletInterop.js to eliminate inline scripts (improves CSP) -->
    <script src="js/leafletInterop.js?v=8"></script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
