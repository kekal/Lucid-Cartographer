@page "/datasources"
@rendermode InteractiveServer
@using LucidCartographer.Services.Import
@using LucidCartographer.Data.Entities
@inject IImportOrchestrator ImportOrchestrator
@inject IPoiService PoiService
@inject IGoogleMapsListScraper Scraper
@implements IAsyncDisposable

<PageTitle>@UiStrings.DataSourcesPageTitle</PageTitle>

<div class="p-6 max-w-6xl mx-auto">
    @* Header *@
    <div class="mb-8">
        <h1 class="sr-only">@UiStrings.DataAndImports</h1>
        <h2 class="text-2xl font-bold font-headline text-on-surface">@UiStrings.DataAndImports</h2>
        <p class="text-on-surface-variant mt-1">@UiStrings.DataAndImportsDesc</p>
    </div>

    @* Import Cards *@
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
        @* GPX/KML Upload Card *@
        <div class="bg-surface-container-low rounded-xl p-5 cursor-pointer hover:bg-surface-container transition-colors @(_activeCard == "file" ? "ring-2 ring-primary" : "")"
             @onclick='() => ShowUpload("file")'>
            <div class="flex items-center gap-3 mb-3">
                <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                    <span class="material-symbols-outlined text-primary">upload_file</span>
                </div>
                <h3 class="font-bold font-headline">@UiStrings.KmlGpxUpload</h3>
            </div>
            <p class="text-sm text-on-surface-variant">@UiStrings.KmlGpxUploadDesc</p>
        </div>

        @* Google Takeout Card *@
        <div class="bg-surface-container-low rounded-xl p-5 cursor-pointer hover:bg-surface-container transition-colors @(_activeCard == "takeout" ? "ring-2 ring-primary" : "")"
             @onclick='() => ShowUpload("takeout")'>
            <div class="flex items-center gap-3 mb-3">
                <div class="w-10 h-10 rounded-lg bg-secondary/10 flex items-center justify-center">
                    <span class="material-symbols-outlined text-secondary">cloud_download</span>
                </div>
                <h3 class="font-bold font-headline">@UiStrings.GoogleTakeout</h3>
            </div>
            <p class="text-sm text-on-surface-variant">@UiStrings.GoogleTakeoutDesc</p>
        </div>

        @* Shared List Card *@
        <div class="bg-surface-container-low rounded-xl p-5 cursor-pointer hover:bg-surface-container transition-colors @(_activeCard == "shared" ? "ring-2 ring-primary" : "")"
             @onclick='() => ShowUpload("shared")'>
            <div class="flex items-center gap-3 mb-3">
                <div class="w-10 h-10 rounded-lg bg-primary-container/10 flex items-center justify-center">
                    <span class="material-symbols-outlined text-primary-container">public</span>
                </div>
                <h3 class="font-bold font-headline">@UiStrings.SharedGoogleList</h3>
            </div>
            <p class="text-sm text-on-surface-variant">@UiStrings.SharedGoogleListDesc</p>
        </div>
    </div>

    @* Upload Area (shown when active) — uses extracted FileUploadPanel *@
    @if (_showUpload)
    {
        <FileUploadPanel Title="@_uploadTitle"
                         AcceptExtensions="@_acceptExtensions"
                         AcceptDescription="@_acceptDescription"
                         AvailableColors="_availableColors"
                         CollectionName="@_collectionName"
                         CollectionNameChanged="(val) => _collectionName = val"
                         SelectedColor="@_selectedColor"
                         SelectedColorChanged="(val) => _selectedColor = val"
                         OnClose="CloseUpload"
                         OnFileSelected="HandleFileSelected"
                         IsImporting="_isImporting"
                         ImportingFileName="@_importingFileName"
                         ImportResult="_importResult"
                         ImportError="@_importError"
                         ShowFileInput="@(_activeCard != "shared")">
            @* Card-specific instructions *@
            @if (_activeCard == "takeout")
            {
                <div class="mb-4 p-4 rounded-lg bg-secondary/5">
                    <h4 class="font-bold text-sm mb-2 flex items-center gap-2">
                        <span class="material-symbols-outlined text-secondary text-base">info</span>
                        How to export from Google Takeout
                    </h4>
                    <ol class="text-sm text-on-surface-variant space-y-1 list-decimal list-inside">
                        <li>Go to <a href="https://takeout.google.com" target="_blank" rel="noopener" class="text-primary underline">takeout.google.com</a></li>
                        <li>Click "Deselect all", then scroll down and check <strong>"Saved"</strong> (for custom lists) and <strong>"Maps (your places)"</strong> (for starred places)</li>
                        <li>Click "Next step" then "Create export" then Download the ZIP</li>
                        <li>Unzip and find <strong>Saved Places.json</strong> (GeoJSON) - upload it below</li>
                    </ol>
                </div>
            }
            else if (_activeCard == "shared")
            {
                <ScraperPanel Url="@_sharedListUrl"
                              UrlChanged="(val) => _sharedListUrl = val"
                              IsScraping="_isScraping"
                              ScrapeProgress="_scrapeProgress"
                              OnScrape="ScrapeSharedList" />
            }
            else if (_activeCard == "file")
            {
                <div class="mb-4 p-4 rounded-lg bg-primary/5">
                    <p class="text-sm text-on-surface-variant">
                        Upload any geo file: <strong>GPX</strong> (from browser extensions), <strong>KML/KMZ</strong> (from Google My Maps), <strong>GeoJSON</strong>, or <strong>CSV</strong> (must contain lat/lon columns).
                    </p>
                </div>
            }
        </FileUploadPanel>
    }

    @* Managed Sources Table *@
    <div>
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-bold font-headline">@UiStrings.ManagedSources</h3>
            <span class="text-sm text-on-surface-variant">@_collections.Count dataset(s)</span>
        </div>

        @if (_collections.Count == 0)
        {
            <div class="bg-surface-container-low rounded-xl p-8 text-center text-on-surface-variant">
                <span class="material-symbols-outlined text-4xl mb-2 block">folder_open</span>
                <p>@UiStrings.NoDatasetsYet</p>
            </div>
        }
        else
        {
            <div class="bg-surface-container-low rounded-xl overflow-hidden" aria-live="polite">
                <table class="w-full">
                    <thead>
                        <tr class="text-left text-sm text-on-surface-variant">
                            <th class="px-4 py-3 font-medium">Dataset Name</th>
                            <th class="px-4 py-3 font-medium">Source</th>
                            <th class="px-4 py-3 font-medium text-right">Points</th>
                            <th class="px-4 py-3 font-medium">Date</th>
                            <th class="px-4 py-3 font-medium text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var col in _collections)
                        {
                            <tr @key="col.Id" class="hover:bg-surface-container transition-colors">
                                <td class="px-4 py-3">
                                    <div class="flex items-center gap-3">
                                        <div class="w-3 h-3 rounded-full" style="background-color: @col.Color" aria-hidden="true"></div>
                                        <span class="font-medium">@col.Name</span>
                                    </div>
                                </td>
                                <td class="px-4 py-3 text-sm text-on-surface-variant">@(col.SourceType ?? "manual")</td>
                                <td class="px-4 py-3 text-sm text-right">@col.PoiCount.ToString("N0")</td>
                                <td class="px-4 py-3 text-sm text-on-surface-variant">@col.CreatedDate.ToString("MMM dd, yyyy")</td>
                                <td class="px-4 py-3 text-right">
                                    @if (_pendingDeleteId == col.Id)
                                    {
                                        <span class="text-xs text-tertiary font-medium mr-1">Delete?</span>
                                        <button class="text-tertiary hover:bg-tertiary/10 p-1 rounded-lg transition-colors text-xs font-medium"
                                                aria-label="@($"Confirm delete {col.Name}")"
                                                @onclick="() => ConfirmDelete(col.Id)">
                                            @UiStrings.Yes
                                        </button>
                                        <button class="text-on-surface-variant hover:bg-surface-container-high p-1 rounded-lg transition-colors text-xs font-medium ml-1"
                                                aria-label="@UiStrings.Cancel"
                                                @onclick="CancelDelete">
                                            @UiStrings.No
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="text-tertiary hover:bg-tertiary/10 p-1 rounded-lg transition-colors"
                                                aria-label="@($"Delete {col.Name}")"
                                                @onclick="() => RequestDelete(col.Id)">
                                            <span class="material-symbols-outlined text-sm" aria-hidden="true">delete</span>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private IReadOnlyList<PoiCollection> _collections = Array.Empty<PoiCollection>();
    private bool _showUpload = false;
    private string _activeCard = "file";
    private string _collectionName = string.Empty;
    private string _selectedColor = "#005bbf";
    private bool _isImporting = false;
    private string? _importingFileName;
    private ImportResult? _importResult;
    private string? _importError;
    private string _sharedListUrl = string.Empty;
    private bool _isScraping = false;
    private int _scrapeProgress = 0;
    private CancellationTokenSource _cts = new();

    private string _uploadTitle => _activeCard switch
    {
        "takeout" => UiStrings.ImportFromTakeout,
        "shared" => UiStrings.ImportSharedList,
        _ => UiStrings.ImportFile
    };

    private string _acceptExtensions => _activeCard switch
    {
        "takeout" => ".geojson,.json",
        "shared" => ".gpx",
        _ => ".gpx,.kml,.kmz,.geojson,.json,.csv"
    };

    private string _acceptDescription => _activeCard switch
    {
        "takeout" => "Upload Saved Places.json from Google Takeout export",
        "shared" => "Upload GPX file from the Firefox extension",
        _ => "Supports GPX, KML, KMZ, GeoJSON, CSV"
    };

    private readonly string[] _availableColors = new[]
    {
        "#005bbf", "#006e2c", "#b81d17", "#7c3aed", "#ca8a04", "#0891b2", "#be185d", "#4b5563"
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadCollections();
    }

    private async Task LoadCollections()
    {
        _collections = await PoiService.GetCollectionsAsync();
    }

    private void ShowUpload(string card)
    {
        _activeCard = card;
        _showUpload = true;
        _importResult = null;
        _importError = null;
    }

    private void CloseUpload()
    {
        _showUpload = false;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        if (string.IsNullOrWhiteSpace(_collectionName))
        {
            _collectionName = Path.GetFileNameWithoutExtension(file.Name);
        }

        _isImporting = true;
        _importingFileName = file.Name;
        _importResult = null;
        _importError = null;
        StateHasChanged();

        try
        {
            const long MaxUploadSizeBytes = 10 * 1024 * 1024; // 10MB max
            using var stream = file.OpenReadStream(maxAllowedSize: MaxUploadSizeBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            _importResult = await ImportOrchestrator.ImportAsync(ms, file.Name, _collectionName, _selectedColor, _cts.Token);
            await LoadCollections();
            _collectionName = string.Empty;
        }
        catch (Exception ex)
        {
            _importError = ex.Message;
        }
        finally
        {
            _isImporting = false;
        }
    }

    private async Task ScrapeSharedList()
    {
        if (string.IsNullOrWhiteSpace(_sharedListUrl)) return;

        _isScraping = true;
        _scrapeProgress = 0;
        _importResult = null;
        _importError = null;
        StateHasChanged();

        try
        {
            var result = await Scraper.ScrapeAsync(_sharedListUrl, count =>
            {
                _scrapeProgress = count;
                _ = InvokeAsync(StateHasChanged).ContinueWith(t =>
                {
                    if (t.IsFaulted)
                        System.Diagnostics.Debug.WriteLine($"Scrape progress render failed: {t.Exception?.Message}");
                }, TaskScheduler.Default);
            }, _cts.Token);

            if (!result.Pois.Any())
            {
                _importError = "No places found. Make sure the URL is a valid Google Maps list.";
                return;
            }

            var name = !string.IsNullOrWhiteSpace(_collectionName)
                ? _collectionName
                : result.ListName ?? $"Shared List ({result.Pois.Count} places)";

            _importResult = await ImportOrchestrator.ImportFromScrapedAsync(result.Pois, name, _selectedColor);
            await LoadCollections();
            _collectionName = string.Empty;
            _sharedListUrl = string.Empty;
        }
        catch (Exception ex)
        {
            _importError = $"Scraping failed: {ex.Message}";
        }
        finally
        {
            _isScraping = false;
        }
    }

    private int? _pendingDeleteId;

    private void RequestDelete(int id)
    {
        _pendingDeleteId = id;
    }

    private void CancelDelete()
    {
        _pendingDeleteId = null;
    }

    private async Task ConfirmDelete(int id)
    {
        _pendingDeleteId = null;
        await PoiService.DeleteCollectionAsync(id);
        await LoadCollections();
    }

    public ValueTask DisposeAsync()
    {
        _cts.Cancel();
        _cts.Dispose();
        return ValueTask.CompletedTask;
    }
}
