@page "/datasources"
@rendermode InteractiveServer
@inject DataSourcesPageViewModel Vm
@implements IAsyncDisposable

<PageTitle>@UiStrings.DataSourcesPageTitle</PageTitle>

<div class="p-6 max-w-6xl mx-auto">
    @* Header *@
    <div class="mb-8">
        <h1 class="sr-only">@UiStrings.DataAndImports</h1>
        <h2 class="text-2xl font-bold font-headline text-on-surface">@UiStrings.DataAndImports</h2>
        <p class="text-on-surface-variant mt-1">@UiStrings.DataAndImportsDesc</p>
    </div>

    @* Import Cards *@
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
        @* GPX/KML Upload Card *@
        <div class="bg-surface-container-low rounded-xl p-5 cursor-pointer hover:bg-surface-container transition-colors @(Vm.ActiveCard == "file" ? "ring-2 ring-primary" : "")"
             @onclick='() => Vm.ShowUploadFor("file")'>
            <div class="flex items-center gap-3 mb-3">
                <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                    <span class="material-symbols-outlined text-primary">upload_file</span>
                </div>
                <h3 class="font-bold font-headline">@UiStrings.KmlGpxUpload</h3>
            </div>
            <p class="text-sm text-on-surface-variant">@UiStrings.KmlGpxUploadDesc</p>
        </div>

        @* Google Takeout Card *@
        <div class="bg-surface-container-low rounded-xl p-5 cursor-pointer hover:bg-surface-container transition-colors @(Vm.ActiveCard == "takeout" ? "ring-2 ring-primary" : "")"
             @onclick='() => Vm.ShowUploadFor("takeout")'>
            <div class="flex items-center gap-3 mb-3">
                <div class="w-10 h-10 rounded-lg bg-secondary/10 flex items-center justify-center">
                    <span class="material-symbols-outlined text-secondary">cloud_download</span>
                </div>
                <h3 class="font-bold font-headline">@UiStrings.GoogleTakeout</h3>
            </div>
            <p class="text-sm text-on-surface-variant">@UiStrings.GoogleTakeoutDesc</p>
        </div>

        @* Shared List Card *@
        <div class="bg-surface-container-low rounded-xl p-5 cursor-pointer hover:bg-surface-container transition-colors @(Vm.ActiveCard == "shared" ? "ring-2 ring-primary" : "")"
             @onclick='() => Vm.ShowUploadFor("shared")'>
            <div class="flex items-center gap-3 mb-3">
                <div class="w-10 h-10 rounded-lg bg-primary-container/10 flex items-center justify-center">
                    <span class="material-symbols-outlined text-primary-container">public</span>
                </div>
                <h3 class="font-bold font-headline">@UiStrings.SharedGoogleList</h3>
            </div>
            <p class="text-sm text-on-surface-variant">@UiStrings.SharedGoogleListDesc</p>
        </div>
    </div>

    @* Upload Area (shown when active) — uses extracted FileUploadPanel *@
    @if (Vm.ShowUpload)
    {
        <FileUploadPanel Title="@Vm.UploadTitle"
                         AcceptExtensions="@Vm.AcceptExtensions"
                         AcceptDescription="@Vm.AcceptDescription"
                         AvailableColors="Vm.AvailableColors"
                         CollectionName="@Vm.CollectionName"
                         CollectionNameChanged="val => Vm.CollectionName = val"
                         SelectedColor="@Vm.SelectedColor"
                         SelectedColorChanged="val => Vm.SelectedColor = val"
                         OnClose="Vm.CloseUpload"
                         OnFileSelected="Vm.HandleFileSelectedAsync"
                         IsImporting="Vm.IsImporting"
                         ImportingFileName="@Vm.ImportingFileName"
                         StatusMessage="@Vm.QueuedMessage"
                         ImportResult="Vm.ImportResult"
                         ImportError="@Vm.ImportError"
                         ShowFileInput="@(Vm.ActiveCard != "shared")">
            @* Card-specific instructions *@
            @switch (Vm.ActiveCard)
            {
                case "takeout":
                    <div class="mb-4 p-4 rounded-lg bg-secondary/5">
                        <h4 class="font-bold text-sm mb-2 flex items-center gap-2">
                            <span class="material-symbols-outlined text-secondary text-base">info</span>
                            How to export from Google Takeout
                        </h4>
                        <ol class="text-sm text-on-surface-variant space-y-1 list-decimal list-inside">
                            <li>Go to <a href="https://takeout.google.com" target="_blank" rel="noopener" class="text-primary underline">takeout.google.com</a></li>
                            <li>Click "Deselect all", then scroll down and check <strong>"Saved"</strong> (for custom lists) and <strong>"Maps (your places)"</strong> (for starred places)</li>
                            <li>Click "Next step" then "Create export" then Download the ZIP</li>
                            <li>Unzip and find <strong>Saved Places.json</strong> (GeoJSON) - upload it below</li>
                        </ol>
                    </div>
                    break;
                case "shared":
                    <ScraperPanel Url="@Vm.SharedListUrl"
                                  UrlChanged="val => Vm.SharedListUrl = val"
                                  IsScraping="Vm.IsImporting"
                                  ScrapeProgress="0"
                                  OnScrape="Vm.ScrapeSharedList"
                                  IsFetchingLists="Vm.IsFetchingLists"
                                  SavedLists="Vm.SavedLists"
                                  FetchListsError="@Vm.FetchListsError"
                                  HasGoogleProfile="Vm.HasGoogleProfile"
                                  OnFetchLists="Vm.HandleFetchMyListsAsync"
                                  OnImportSelected="Vm.HandleImportSelectedLists"
                                  OnResetProfile="Vm.HandleResetProfile" />
                    break;
                case "file":
                    <div class="mb-4 p-4 rounded-lg bg-primary/5">
                        <p class="text-sm text-on-surface-variant">
                            Upload any geo file: <strong>GPX</strong> (from browser extensions), <strong>KML/KMZ</strong> (from Google My Maps), <strong>GeoJSON</strong>, or <strong>CSV</strong> (must contain lat/lon columns).
                        </p>
                    </div>
                    break;
            }
        </FileUploadPanel>
    }

    @* Managed Sources Table *@
    <div>
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-bold font-headline">@UiStrings.ManagedSources</h3>
            <div class="flex items-center gap-3">
                <span class="text-sm text-on-surface-variant">@Vm.Collections.Count dataset(s)</span>
                <button class="text-xs px-2.5 py-1.5 rounded-lg border border-outline-variant hover:bg-surface-container transition-colors disabled:opacity-50"
                        disabled="@(Vm.FailedEnrichmentCount == 0)"
                        @onclick="Vm.HandleResetFailedEnrichmentAsync">
                    @UiStrings.ResetFailedEnrichment (@Vm.FailedEnrichmentCount)
                </button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Vm.MaintenanceMessage))
        {
            <div class="mb-4 p-2 rounded-lg bg-primary/10 text-primary text-sm">@Vm.MaintenanceMessage</div>
        }

        @if (Vm.Collections.Count == 0)
        {
            <div class="bg-surface-container-low rounded-xl p-8 text-center text-on-surface-variant">
                <span class="material-symbols-outlined text-4xl mb-2 block">folder_open</span>
                <p>@UiStrings.NoDatasetsYet</p>
            </div>
        }
        else
        {
            <div class="bg-surface-container-low rounded-xl overflow-hidden" aria-live="polite">
                <table class="w-full">
                    <thead>
                        <tr class="text-left text-sm text-on-surface-variant">
                            <th class="px-4 py-3 font-medium">Dataset Name</th>
                            <th class="px-4 py-3 font-medium">Source</th>
                            <th class="px-4 py-3 font-medium text-right">Points</th>
                            <th class="px-4 py-3 font-medium">Date</th>
                            <th class="px-4 py-3 font-medium text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var col in Vm.Collections)
                        {
                            <tr @key="col.Id" class="hover:bg-surface-container transition-colors">
                                <td class="px-4 py-3">
                                    <div class="flex items-center gap-3">
                                        <button type="button"
                                                class="w-3 h-3 rounded-full cursor-pointer focus:outline-none focus:ring-2 focus:ring-primary"
                                                style="background-color: @col.Color"
                                                aria-label="@($"Change color for {col.Name}")"
                                                title="Change dataset color"
                                                @onclick="() => Vm.OpenColorPicker(col)">
                                        </button>
                                        <span class="font-medium">@col.Name</span>
                                    </div>
                                </td>
                                <td class="px-4 py-3 text-sm text-on-surface-variant">@(col.SourceType ?? "manual")</td>
                                <td class="px-4 py-3 text-sm text-right">@col.PoiCount.ToString("N0")</td>
                                <td class="px-4 py-3 text-sm text-on-surface-variant">@col.CreatedDate.ToString("MMM dd, yyyy")</td>
                                <td class="px-4 py-3 text-right">
                                    @if (Vm.PendingDeleteId == col.Id)
                                    {
                                        <span class="text-xs text-tertiary font-medium mr-1">Delete?</span>
                                        <button class="text-tertiary hover:bg-tertiary/10 p-1 rounded-lg transition-colors text-xs font-medium"
                                                aria-label="@($"Confirm delete {col.Name}")"
                                                @onclick="() => Vm.ConfirmDeleteAsync(col.Id)">
                                            @UiStrings.Yes
                                        </button>
                                        <button class="text-on-surface-variant hover:bg-surface-container-high p-1 rounded-lg transition-colors text-xs font-medium ml-1"
                                                aria-label="@UiStrings.Cancel"
                                                @onclick="Vm.CancelDelete">
                                            @UiStrings.No
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="text-primary hover:bg-primary/10 p-1 rounded-lg transition-colors"
                                                aria-label="@($"Add POI to {col.Name}")"
                                                title="Add POI"
                                                @onclick="() => Vm.OpenAddPoi(col.Id)">
                                            <span class="material-symbols-outlined text-sm" aria-hidden="true">add_location</span>
                                        </button>
                                        <button class="text-primary hover:bg-primary/10 p-1 rounded-lg transition-colors"
                                                aria-label="@($"Re-enrich all POIs in {col.Name}")"
                                                title="Re-enrich all POIs"
                                                disabled="@(Vm.EnrichingCollectionId == col.Id)"
                                                @onclick="() => Vm.HandleEnrichCollectionAsync(col.Id)">
                                            <span class="material-symbols-outlined text-sm" aria-hidden="true">
                                                @(Vm.EnrichingCollectionId == col.Id ? "hourglass_empty" : "auto_fix_high")
                                            </span>
                                        </button>
                                        <button class="text-primary hover:bg-primary/10 p-1 rounded-lg transition-colors"
                                                aria-label="@($"Export {col.Name} to Google My Maps")"
                                                title="Export to Google My Maps"
                                                disabled="@(Vm.ExportingId == col.Id)"
                                                @onclick="() => Vm.HandleExportToMyMapsAsync(col.Id)">
                                            <span class="material-symbols-outlined text-sm" aria-hidden="true">
                                                @(Vm.ExportingId == col.Id ? "hourglass_empty" : "map")
                                            </span>
                                        </button>
                                        <button class="text-tertiary hover:bg-tertiary/10 p-1 rounded-lg transition-colors"
                                                aria-label="@($"Delete {col.Name}")"
                                                @onclick="() => Vm.RequestDelete(col.Id)">
                                            <span class="material-symbols-outlined text-sm" aria-hidden="true">delete</span>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* Add POI inline form *@
            @if (Vm.AddPoiCollectionId != null)
            {
                var targetCol = Vm.Collections.FirstOrDefault(c => c.Id == Vm.AddPoiCollectionId);
                <div class="mt-4 bg-surface-container rounded-xl p-5">
                    <div class="flex items-center justify-between mb-3">
                        <h4 class="font-bold font-headline text-sm flex items-center gap-2">
                            <span class="material-symbols-outlined text-primary text-base">add_location</span>
                            Add POI to @(targetCol?.Name ?? "collection")
                        </h4>
                        <button class="p-1 rounded hover:bg-surface-container-high transition-colors"
                                aria-label="Cancel"
                                @onclick="Vm.CloseAddPoi">
                            <span class="material-symbols-outlined text-sm">close</span>
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(Vm.AddPoiError))
                    {
                        <div class="mb-3 p-2 rounded-lg bg-tertiary/10 text-tertiary text-sm">@Vm.AddPoiError</div>
                    }
                    @if (Vm.AddPoiSuccess)
                    {
                        <div class="mb-3 p-2 rounded-lg bg-secondary/10 text-secondary text-sm flex items-center gap-1.5">
                            <span class="material-symbols-outlined text-sm">check_circle</span>
                            POI added — details will be filled by enrichment.
                        </div>
                    }

                    <div class="flex gap-2">
                        <input type="text" @bind="Vm.AddPoiUrl" @bind:event="oninput"
                               placeholder="Paste Google Maps link (e.g. https://maps.app.goo.gl/... or https://www.google.com/maps/place/...)"
                               class="flex-1 rounded-lg border border-outline-variant bg-surface px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary" />
                        <button class="px-4 py-2 text-sm rounded-lg bg-primary text-on-primary hover:bg-primary/90 transition-colors font-medium disabled:opacity-50 whitespace-nowrap"
                                disabled="@(Vm.AddPoiSaving || string.IsNullOrWhiteSpace(Vm.AddPoiUrl))"
                                @onclick="Vm.SaveNewPoiAsync">
                            @(Vm.AddPoiSaving ? "Adding…" : "Add")
                        </button>
                    </div>
                    <p class="text-xs text-on-surface-variant mt-2">
                        Name, address, coordinates and other details will be auto-filled by the enrichment service.
                    </p>
                </div>
            }
        }
    </div>
</div>

@if (Vm.ColorPickerCollectionId != null)
{
    var targetCollection = Vm.Collections.FirstOrDefault(c => c.Id == Vm.ColorPickerCollectionId.Value);
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-4" role="dialog" aria-modal="true" aria-label="Change collection color">
        <div class="w-full max-w-md rounded-xl bg-surface-container p-5 shadow-xl">
            <div class="flex items-center justify-between mb-4">
                <h4 class="font-bold font-headline text-base">Change color: @(targetCollection?.Name ?? "Collection")</h4>
                <button type="button"
                        class="p-1 rounded hover:bg-surface-container-high transition-colors"
                        aria-label="Close color picker"
                        @onclick="Vm.CloseColorPicker">
                    <span class="material-symbols-outlined text-sm">close</span>
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(Vm.ColorPickerError))
            {
                <div class="mb-3 p-2 rounded-lg bg-tertiary/10 text-tertiary text-sm">@Vm.ColorPickerError</div>
            }

            <div class="mb-4">
                <label class="block text-sm font-medium mb-2">Color</label>
                <div class="flex items-center gap-3">
                    <input type="color"
                           class="h-10 w-14 rounded border border-outline-variant bg-surface"
                           @bind="Vm.ColorPickerValue" />
                    <span class="text-sm text-on-surface-variant">@Vm.ColorPickerValue</span>
                </div>
            </div>

            <div class="flex flex-wrap gap-2 mb-4">
                @foreach (var color in Vm.AvailableColors)
                {
                    var isSelected = string.Equals(Vm.ColorPickerValue, color, StringComparison.OrdinalIgnoreCase);
                    var swatchStyle = $"background-color: {color}; width: 1.75rem; height: 1.75rem; border-radius: 9999px;";
                    if (isSelected)
                    {
                        swatchStyle += " outline: 2px solid #005bbf; outline-offset: 2px;";
                    }
                    <button type="button"
                            class="border border-outline-variant p-0 flex-shrink-0"
                            style="@swatchStyle"
                            aria-label="@($"Use color {color}")"
                            @onclick="() => Vm.ColorPickerValue = color">
                    </button>
                }
            </div>

            <div class="flex justify-end gap-2">
                <button type="button"
                        class="px-3 py-2 text-sm rounded-lg border border-outline-variant hover:bg-surface-container-high transition-colors"
                        @onclick="Vm.CloseColorPicker"
                        disabled="@Vm.IsSavingColorPicker">
                    Cancel
                </button>
                <button type="button"
                        class="px-3 py-2 text-sm rounded-lg bg-primary text-on-primary hover:bg-primary/90 transition-colors disabled:opacity-50"
                        @onclick="Vm.SaveCollectionColorAsync"
                        disabled="@Vm.IsSavingColorPicker">
                    @(Vm.IsSavingColorPicker ? "Saving..." : "Save")
                </button>
            </div>
        </div>
    </div>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        Vm.StateChanged += OnVmChanged;
        await Vm.InitializeAsync();
    }

    private void OnVmChanged() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Vm.StateChanged -= OnVmChanged;
        await Vm.DisposeAsync();
    }
}
