@inject ViewportService Viewport
@inject IJSRuntime Js
@implements IAsyncDisposable

@code {
    private DotNetObjectReference<ViewportObserver>? _selfRef;
    private bool _registered;
    // Token from JS side; compared on unregister to ensure only this observer's teardown runs.
    private int _registrationToken;

    /// <summary>
    /// Result from LucidViewport.register. Blazor's case-insensitive JSON deserialization
    /// (JsonSerializerDefaults.Web) binds JS `{ width, token }` to these PascalCase properties.
    /// </summary>
    private sealed class RegistrationResult
    {
        public int Width { get; set; }
        public int Token { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _registered)
        {
            return;
        }

        _registered = true;
        _selfRef = DotNetObjectReference.Create(this);
        try
        {
            var result = await Js.InvokeAsync<RegistrationResult>("LucidViewport.register", _selfRef);
            // Guard: bUnit's mock JS interop returns null for unconfigured calls.
            if (result is not null)
            {
                _registrationToken = result.Token;
                Viewport.SetWidth(result.Width);
            }

            // Reapply theme: in-circuit SPA nav doesn't fire enhancedload, and Blazor's diff clears <html> attributes set by JS.
            await Js.InvokeVoidAsync("LucidTheme.apply");
        }
        catch (JSDisconnectedException)
        {
            // Circuit went away during init; nothing to observe.
        }
        catch (InvalidOperationException)
        {
            // Prerender/static path where JS interop isn't available yet.
        }
        catch (JSException)
        {
            // LucidTheme may not be defined in some test contexts.
        }
    }

    [JSInvokable]
    public void OnViewportChanged(int width)
    {
        Viewport.SetWidth(width);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            // Pass our token; JS compares and ignores if a newer observer owns the viewport.
            await Js.InvokeVoidAsync("LucidViewport.unregister", _registrationToken);
        }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
        catch (JSException) { }
        finally
        {
            _selfRef?.Dispose();
        }
    }
}
