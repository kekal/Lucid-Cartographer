@inject ViewportService Viewport
@inject IJSRuntime Js
@implements IAsyncDisposable

@* Invisible component: registers a browser resize listener and forwards the
   viewport width into the circuit-scoped ViewportService. Drop one of these in
   MainLayout so the desktop/mobile verdict is available everywhere on the
   circuit. Renders nothing. *@

@code {
    private DotNetObjectReference<ViewportObserver>? _selfRef;
    private bool _registered;
    // M01 (Wave 7): integer token returned by LucidViewport.register. The JS
    // side compares tokens (not refs) on unregister; passing back the same
    // token we received guarantees only THIS observer's teardown runs even if
    // a newer observer has already registered.
    private int _registrationToken;

    /// <summary>
    /// Shape of the value returned by LucidViewport.register — viewport width
    /// plus a token that identifies this particular registration on dispose.
    /// Blazor JS interop uses System.Text.Json with case-insensitive matching
    /// (JsonSerializerDefaults.Web), so the JS-side `{ width, token }` object
    /// binds to these PascalCase properties via the constructor.
    /// </summary>
    private sealed class RegistrationResult
    {
        public int Width { get; set; }
        public int Token { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _registered)
        {
            return;
        }

        _registered = true;
        _selfRef = DotNetObjectReference.Create(this);
        try
        {
            var result = await Js.InvokeAsync<RegistrationResult>("LucidViewport.register", _selfRef);
            // bUnit's loose JSInterop returns default(RegistrationResult) == null
            // for unconfigured calls; guard so test renders don't NRE.
            if (result is not null)
            {
                _registrationToken = result.Token;
                Viewport.SetWidth(result.Width);
            }

            // M05 (Wave 7): re-apply the saved theme on every page's first
            // interactive render. Blazor's in-circuit SPA navigation between
            // InteractiveServer pages does NOT fire `enhancedload` (that event
            // is reserved for ENHANCED HTTP navigation), and the renderer's
            // diff clears `<html>` attributes the JS side set. Re-applying
            // here closes that gap — every page hosts a ViewportObserver, so
            // every nav lands with the correct theme.
            await Js.InvokeVoidAsync("LucidTheme.apply");
        }
        catch (JSDisconnectedException)
        {
            // Circuit went away during init; nothing to observe.
        }
        catch (InvalidOperationException)
        {
            // Prerender/static path where JS interop isn't available yet.
        }
        catch (JSException)
        {
            // LucidTheme may not be defined in some test contexts.
        }
    }

    [JSInvokable]
    public void OnViewportChanged(int width)
    {
        Viewport.SetWidth(width);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            // M01 (Wave 7): hand the JS side OUR token. It compares tokens and
            // ignores the call if a newer observer is the current owner.
            await Js.InvokeVoidAsync("LucidViewport.unregister", _registrationToken);
        }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
        catch (JSException) { }
        finally
        {
            _selfRef?.Dispose();
        }
    }
}
