@inject NavigationManager Nav

@* Mobile-only tab bar (shown via CSS); uses role="navigation" div instead of <nav> tag to avoid test selector collisions with the desktop header. *@
<div class="m-tabbar" role="navigation" aria-label="Mobile navigation">
    @foreach (var t in Tabs)
    {
        var active = IsActive(t);
        <NavLink class="@(active ? "active" : "")" href="@t.Href" Match="@t.Match" aria-current="@(active ? "page" : null)">
            <span class="ms @(active ? "filled" : "")" aria-hidden="true">@t.Icon</span>
            <span>@t.Label</span>
        </NavLink>
    }
</div>

@code {
    private sealed record Tab(string Href, NavLinkMatch Match, string Icon, string Label);

    private readonly Tab[] Tabs =
    [
        new("", NavLinkMatch.All, "map", UiStrings.NavMap),
        new("datasources", NavLinkMatch.Prefix, "folder_open", UiStrings.NavSources),
        new("operations", NavLinkMatch.Prefix, "hub", UiStrings.NavOperations),
        new("more", NavLinkMatch.Prefix, "more_horiz", UiStrings.NavMore),
    ];

    private bool IsActive(Tab t)
    {
        var rel = Nav.ToBaseRelativePath(Nav.Uri);
        var path = rel.Split('?', '#')[0].Trim('/');
        return t.Match == NavLinkMatch.All
            ? path.Length == 0
            : path.StartsWith(t.Href, StringComparison.OrdinalIgnoreCase);
    }
}
