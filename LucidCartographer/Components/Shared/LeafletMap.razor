@using LucidCartographer.Data.Entities
@inject IMapService MapService
@inject ILogger<LeafletMap> Logger
@implements IAsyncDisposable

<div id="@_mapElementId" style="width:100%;height:100%;"></div>

@code {
    [Parameter] public EventCallback<int> OnMarkerSelected { get; set; }
    [Parameter] public EventCallback<MapBounds> OnBoundsChanged { get; set; }

    // GUID ensures uniqueness across multiple instances and mount/unmount cycles
    private readonly string _mapElementId = $"leaflet-map-{Guid.NewGuid():N}";
    private readonly TaskCompletionSource _initTcs = new(TaskCreationOptions.RunContinuationsAsynchronously);

    /// <summary>Returns Task that completes when map JS initialization is done.</summary>
    public Task WaitForInitAsync() => _initTcs.Task;

    public bool IsInitialized { get; private set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Set callback via Func instead of subscribing to event
            MapService.OnMarkerClicked = HandleMarkerClickedAsync;
            MapService.OnBoundsChanged = HandleBoundsChangedAsync;
            try
            {
                await MapService.InitMapAsync(_mapElementId);
                await MapService.EnableBoundsTrackingAsync();
                IsInitialized = true;
                _initTcs.TrySetResult();
            }
            catch (Exception ex)
            {
                _initTcs.TrySetException(ex);
                throw;
            }
        }
    }

    public async Task ShowCollectionAsync(int collectionId, List<Poi> pois, string color)
    {
        if (!IsInitialized)
        {
            return;
        }

        await MapService.ShowCollectionAsync(collectionId, pois, color);
    }

    public async Task HideCollectionAsync(int collectionId)
    {
        if (!IsInitialized)
        {
            return;
        }

        await MapService.HideCollectionAsync(collectionId);
    }

    public async Task FocusOnPoiAsync(double lat, double lon, int zoom = 16)
    {
        if (!IsInitialized)
        {
            return;
        }

        await MapService.FocusOnPoiAsync(lat, lon, zoom);
    }

    public async Task FitBoundsAsync()
    {
        if (!IsInitialized)
        {
            return;
        }

        await MapService.FitBoundsAsync();
    }

    public async Task RefreshLayoutAsync()
    {
        if (!IsInitialized)
        {
            return;
        }

        await MapService.RefreshLayoutAsync();
    }

    public async Task HighlightMarkerAsync(int poiId)
    {
        if (!IsInitialized)
        {
            return;
        }

        await MapService.HighlightMarkerAsync(poiId);
    }

    public async Task SetLabelsVisibleAsync(bool visible)
    {
        if (!IsInitialized)
        {
            return;
        }

        await MapService.SetLabelsVisibleAsync(visible);
    }

    public async Task SetStopOrdersAsync(IReadOnlyDictionary<int, int>? orders, TripMarkerRolesDto? roles = null)
    {
        if (!IsInitialized)
        {
            return;
        }

        await MapService.SetStopOrdersAsync(orders, roles);
    }

    public async Task DrawTripLegsAsync(IReadOnlyList<TripLegDto> legs, bool isRoundtrip = false)
    {
        if (!IsInitialized)
        {
            return;
        }

        await MapService.DrawTripLegsAsync(legs, isRoundtrip);
    }

    public async Task ClearTripAsync()
    {
        if (!IsInitialized)
        {
            return;
        }

        await MapService.ClearTripAsync();
    }

    // Forward the active routing provider's OSM/ODbL attribution to the map's attribution control
    // (null removes any prior routing attribution — the default Mock declares none)
    public async Task SetRoutingAttributionAsync(string? html)
    {
        if (!IsInitialized)
        {
            return;
        }

        await MapService.SetRoutingAttributionAsync(html);
    }

    public async Task EmphasizeStopAsync(int? poiId)
    {
        if (!IsInitialized)
        {
            return;
        }

        await MapService.EmphasizeStopAsync(poiId);
    }

    public async Task PanToStopAsync(int poiId)
    {
        if (!IsInitialized)
        {
            return;
        }

        await MapService.PanToStopAsync(poiId);
    }

    private async Task HandleMarkerClickedAsync(int poiId)
    {
        try
        {
            await InvokeAsync(async () => await OnMarkerSelected.InvokeAsync(poiId));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error handling marker click for POI {PoiId}", poiId);
        }
    }

    private async Task HandleBoundsChangedAsync(MapBounds bounds)
    {
        try
        {
            await InvokeAsync(async () => await OnBoundsChanged.InvokeAsync(bounds));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error handling bounds change");
        }
    }

    public async ValueTask DisposeAsync()
    {
        MapService.OnMarkerClicked = null;
        MapService.OnBoundsChanged = null;
        _initTcs.TrySetCanceled();

        // Flip IsInitialized first so concurrent VM calls short-circuit during JS teardown
        var wasInitialized = IsInitialized;
        IsInitialized = false;

        // Tear down JS-side map only; service lifetime is owned by the Blazor circuit (scoped).
        if (wasInitialized)
        {
            try
            {
                await MapService.DestroyMapAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone — JS side cleans itself up.
            }
            catch (ObjectDisposedException)
            {
                // JS runtime already disposed.
            }
            catch (InvalidOperationException)
            {
                // Static prerender/teardown path — safe to ignore.
            }
        }
    }
}
