@using LucidCartographer.Data.Entities
@using LucidCartographer.Services

@if (Poi is null)
{
    return;
}

<div class="fixed inset-0 flex items-center justify-center bg-black/40"
     style="z-index: 10000;"
     role="dialog" aria-modal="true" aria-labelledby="enrich-fallback-title"
     @onclick="HandleBackdropClickAsync">
    <div class="bg-white rounded-lg shadow-xl w-full max-w-md mx-4 p-5"
         @onclick:stopPropagation="true">
        <h3 id="enrich-fallback-title" class="text-lg font-bold font-headline mb-2">
            @string.Format(UiStrings.EnrichFallbackTitle, Poi.Name)
        </h3>
        <p class="text-sm text-on-surface-variant mb-4">@UiStrings.EnrichFallbackBody</p>

        <a href="@SearchUrl" target="_blank" rel="noopener"
           class="inline-flex items-center gap-2 text-sm text-primary hover:underline mb-4">
            <span class="material-symbols-outlined text-base" aria-hidden="true">open_in_new</span>
            @UiStrings.EnrichFallbackSearchLink
        </a>

        <label for="enrich-fallback-url" class="block text-xs uppercase tracking-wider text-on-surface-variant mb-1">
            @UiStrings.EnrichFallbackUrlLabel
        </label>
        <input id="enrich-fallback-url" type="url"
               @bind="_url" @bind:event="oninput"
               placeholder="https://www.google.com/maps/place/..."
               class="w-full px-3 py-2 mb-1 border border-surface-container-high rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-primary" />
        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="text-xs text-red-600 mb-2">@_error</p>
        }

        <div class="flex justify-end gap-2 mt-4">
            <button type="button"
                    @onclick="() => OnClose.InvokeAsync()"
                    class="px-4 py-2 rounded-md text-sm font-medium text-on-surface hover:bg-surface-container-low">
                @UiStrings.Cancel
            </button>
            <button type="button"
                    @onclick="HandleSubmitAsync"
                    disabled="@(_submitting || string.IsNullOrWhiteSpace(_url))"
                    class="px-4 py-2 rounded-md text-sm font-medium bg-primary text-white hover:shadow disabled:opacity-50 disabled:cursor-not-allowed">
                @(_submitting ? UiStrings.Loading : UiStrings.EnrichDetails)
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Poi Poi { get; set; } = null!;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnSubmit { get; set; }

    private string _url = string.Empty;
    private string? _error;
    private bool _submitting;
    // -1 sentinel so the very first OnParametersSet always triggers the
    // reset path, even if the incoming Poi happens to have Id 0.
    private int _lastSeenPoiId = -1;

    private string SearchUrl =>
        "https://www.google.com/maps/search/?api=1&query=" +
        Uri.EscapeDataString(string.IsNullOrWhiteSpace(Poi.Category) ? Poi.Name : $"{Poi.Name} {Poi.Category}");

    protected override void OnParametersSet()
    {
        if (Poi.Id != _lastSeenPoiId)
        {
            _lastSeenPoiId = Poi.Id;
            _url = string.Empty;
            _error = null;
            _submitting = false;
        }
    }

    private async Task HandleSubmitAsync()
    {
        var trimmed = _url.Trim();
        if (!IsLikelyPlaceUrl(trimmed))
        {
            _error = UiStrings.EnrichFallbackInvalidUrl;
            return;
        }

        _error = null;
        _submitting = true;
        try
        {
            await OnSubmit.InvokeAsync(trimmed);
        }
        finally
        {
            _submitting = false;
        }
    }

    private Task HandleBackdropClickAsync() => OnClose.InvokeAsync();

    private static bool IsLikelyPlaceUrl(string url)
    {
        if (!Uri.TryCreate(url, UriKind.Absolute, out var uri))
        {
            return false;
        }
        var host = uri.Host.ToLowerInvariant();
        // maps.app.goo.gl is the canonical Google Maps short link; legacy
        // goo.gl/maps was retired in 2024. A bare goo.gl/* shortlink may
        // point anywhere, so don't accept it without an explicit /maps path.
        if (host == "maps.app.goo.gl")
        {
            return true;
        }
        return host.Contains("google.") && uri.AbsolutePath.Contains("/maps");
    }
}
