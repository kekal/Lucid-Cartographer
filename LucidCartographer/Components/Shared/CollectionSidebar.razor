@using LucidCartographer.Data.Entities
@using LucidCartographer.Services

<div class="flex flex-col h-full">
    <div class="p-4 flex-shrink-0">
        <h3 class="text-xs font-semibold text-on-surface-variant uppercase tracking-wider mb-1">@UiStrings.Collections</h3>
    </div>

    <div class="flex-1 overflow-y-auto px-2" role="listbox" aria-label="Collection list">
        @if (Collections == null || !Collections.Any())
        {
            <div class="px-2 py-4 text-center text-sm text-on-surface-variant">
                <p>@UiStrings.NoCollectionsYet</p>
                <p class="text-xs mt-1">@UiStrings.ImportDataHint</p>
            </div>
        }
        else
        {
            @for (int i = 0; i < Collections.Count; i++)
            {
                var index = i;
                var vm = Collections[index];
                <div @key="vm.Id"
                     class="flex items-center gap-2 px-2 py-2 rounded-lg cursor-pointer transition-colors
                            @(SelectedCollectionId == vm.Id ? "bg-surface-container-high" : "hover:bg-surface-container-low")"
                     role="option"
                     aria-selected="@(SelectedCollectionId == vm.Id)"
                     tabindex="0"
                     @onclick="() => HandleCollectionClick(vm.Id)"
                     @onkeydown="(e) => HandleKeyDown(e, vm.Id, index)">
                    <div class="w-3 h-3 rounded-full flex-shrink-0" style="background-color: @vm.Color"
                         aria-hidden="true"></div>
                    <div class="flex-1 min-w-0">
                        <div class="text-sm font-medium truncate">@vm.Name</div>
                    </div>
                    <span class="text-xs text-on-surface-variant flex-shrink-0">@vm.PoiCount</span>
                    <button class="p-0.5 rounded hover:bg-surface-container-highest transition-colors flex-shrink-0"
                            aria-label="@($"Toggle visibility for {vm.Name}")"
                            @onclick:stopPropagation="true"
                            @onclick="() => HandleVisibilityClick(vm.Id)">
                        <span class="material-symbols-outlined text-base text-on-surface-variant"
                              style="font-variation-settings: 'FILL' @(vm.IsVisible ? 1 : 0)"
                              aria-hidden="true">
                            visibility
                        </span>
                        <span class="sr-only">@(vm.IsVisible ? "Visible" : "Hidden")</span>
                    </button>
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<CollectionViewModel> Collections { get; set; } = Array.Empty<CollectionViewModel>();
    [Parameter] public int? SelectedCollectionId { get; set; }
    [Parameter] public EventCallback<int> OnCollectionSelected { get; set; }
    [Parameter] public EventCallback<int> OnVisibilityToggled { get; set; }

    private async Task HandleCollectionClick(int collectionId)
    {
        try
        {
            await OnCollectionSelected.InvokeAsync(collectionId);
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error selecting collection {collectionId}: {ex.Message}");
        }
    }

    private async Task HandleVisibilityClick(int collectionId)
    {
        try
        {
            await OnVisibilityToggled.InvokeAsync(collectionId);
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error toggling visibility for collection {collectionId}: {ex.Message}");
        }
    }

    // LOW-12: Arrow key navigation between collection list items (WAI-ARIA listbox pattern)
    private async Task HandleKeyDown(KeyboardEventArgs e, int collectionId, int index)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            await HandleCollectionClick(collectionId);
        }
        else if (e.Key == "ArrowDown" && index < Collections.Count - 1)
        {
            await HandleCollectionClick(Collections[index + 1].Id);
        }
        else if (e.Key == "ArrowUp" && index > 0)
        {
            await HandleCollectionClick(Collections[index - 1].Id);
        }
    }
}
