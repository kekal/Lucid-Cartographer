<div class="flex flex-col h-full">
    <div class="p-4 flex-shrink-0">
        <h3 class="text-xs font-semibold text-on-surface-variant uppercase tracking-wider mb-1">@UiStrings.Collections</h3>
    </div>

    @* Each collection row is a visibility TOGGLE — clicking anywhere on the
       row shows/hides that collection. The POI list and the map are driven
       purely by which collections are visible (the union of all visible
       ones), so there is no separate "select collection" action that would
       swap the list to a single, possibly-hidden collection. The eye icon is
       a pure indicator of the row's pressed state. *@
    <div class="flex-1 overflow-y-auto px-2" role="group" aria-label="Collection visibility">
        @if (Collections == null || !Collections.Any())
        {
            <div class="px-2 py-4 text-center text-sm text-on-surface-variant">
                <p>@UiStrings.NoCollectionsYet</p>
                <p class="text-xs mt-1">@UiStrings.ImportDataHint</p>
            </div>
        }
        else
        {
            @foreach (var vm in Collections)
            {
                var collectionId = vm.Id;
                <div @key="vm.Id"
                     class="flex items-center gap-2 px-2 py-2 rounded-lg cursor-pointer transition-colors
                            @(vm.IsVisible ? "bg-surface-container-high" : "hover:bg-surface-container-low")"
                     role="button"
                     aria-pressed="@(vm.IsVisible ? "true" : "false")"
                     aria-label="@($"Toggle visibility for {vm.Name}")"
                     tabindex="0"
                     @onclick="() => HandleToggle(collectionId)"
                     @onkeydown="e => HandleKeyDown(e, collectionId)">
                    <div class="w-3 h-3 rounded-full flex-shrink-0" style="background-color: @vm.Color"
                         aria-hidden="true"></div>
                    <div class="flex-1 min-w-0">
                        <div class="text-sm font-medium truncate @(vm.IsVisible ? "" : "text-on-surface-variant")">@vm.Name</div>
                    </div>
                    <span class="text-xs text-on-surface-variant flex-shrink-0">@vm.PoiCount</span>
                    <span class="material-symbols-outlined text-base text-on-surface-variant flex-shrink-0"
                          style="font-variation-settings: 'FILL' @(vm.IsVisible ? 1 : 0)"
                          aria-hidden="true">
                        @(vm.IsVisible ? "visibility" : "visibility_off")
                    </span>
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<CollectionDisplayState> Collections { get; set; } = [];
    [Parameter] public EventCallback<int> OnVisibilityToggled { get; set; }

    private async Task HandleToggle(int collectionId)
    {
        try
        {
            await OnVisibilityToggled.InvokeAsync(collectionId);
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error toggling visibility for collection {collectionId}: {ex.Message}");
        }
    }

    // Keyboard: the row is a toggle button, so Enter/Space activates it.
    // Tab moves between rows natively (each row is tabindex=0) — no custom
    // arrow-key navigation needed now that the list isn't a single-select
    // listbox.
    private async Task HandleKeyDown(KeyboardEventArgs e, int collectionId)
    {
        if (e.Key is "Enter" or " ")
        {
            await HandleToggle(collectionId);
        }
    }
}
