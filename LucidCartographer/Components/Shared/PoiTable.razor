@using LucidCartographer.Data.Entities

<div class="flex flex-col h-full">
    @* Table Header *@
    <div class="flex items-center justify-between px-4 py-2 flex-shrink-0 bg-surface-container-low/50">
        <div class="flex items-center gap-2">
            <span class="font-bold font-headline text-sm">@UiStrings.FilteredResults</span>
            <span class="text-xs text-on-surface-variant bg-surface-container-high px-2 py-0.5 rounded-full" aria-live="polite">@Pois.Count items</span>
        </div>
    </div>

    @* Table Content *@
    <div class="flex-1 overflow-y-auto">
        @if (!Pois.Any())
        {
            <div class="p-8 text-center text-on-surface-variant text-sm">
                <span class="material-symbols-outlined text-3xl mb-2 block" aria-hidden="true">location_off</span>
                <p>@UiStrings.NoPoiToDisplay</p>
            </div>
        }
        else
        {
            <table class="w-full text-sm" aria-label="Points of interest">
                <thead class="sticky top-0 bg-surface z-10">
                    <tr class="text-left text-xs text-on-surface-variant">
                        <th class="px-4 py-2 font-medium" scope="col">Location Name</th>
                        <th class="px-4 py-2 font-medium" scope="col">Coordinates</th>
                        <th class="px-4 py-2 font-medium" scope="col">Collection</th>
                        <th class="px-4 py-2 font-medium" scope="col">Added</th>
                        <th class="px-4 py-2 font-medium text-right" scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <Virtualize Items="@Pois.ToList()" Context="poi" ItemSize="44">
                        <tr @key="poi.Id"
                            class="hover:bg-surface-container-low transition-colors cursor-pointer @(SelectedPoiId == poi.Id ? "bg-surface-container" : "")"
                            @onclick="() => HandlePoiClick(poi.Id)">
                            <td class="px-4 py-2.5">
                                <div class="flex items-center gap-2">
                                    <span class="material-symbols-outlined text-base text-on-surface-variant" aria-hidden="true">location_on</span>
                                    <div>
                                        <div class="font-medium">@poi.Name</div>
                                        @if (!string.IsNullOrEmpty(poi.Address))
                                        {
                                            <div class="text-xs text-on-surface-variant">@poi.Address</div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="px-4 py-2.5 text-xs text-on-surface-variant font-mono">
                                @poi.Latitude.ToString("F4"), @poi.Longitude.ToString("F4")
                            </td>
                            <td class="px-4 py-2.5">
                                @{ var cn = GetCollectionName(poi.Id); }
                                @if (cn != null)
                                {
                                    <span class="text-xs px-2 py-0.5 rounded-full bg-surface-container-high">@cn</span>
                                }
                            </td>
                            <td class="px-4 py-2.5 text-xs text-on-surface-variant">@poi.AddedDate.ToString("MMM dd, yyyy")</td>
                            <td class="px-4 py-2.5 text-right whitespace-nowrap">
                                <a href="@PoiUrlHelper.GetGoogleMapsUrl(poi)"
                                   target="_blank" rel="noopener"
                                   class="text-primary hover:text-primary-container transition-colors p-1 inline-block"
                                   aria-label="@($"Open {poi.Name} in Google Maps")"
                                   @onclick:stopPropagation="true">
                                    <span class="material-symbols-outlined text-base" aria-hidden="true">open_in_new</span>
                                </a>
                                <button class="text-on-surface-variant hover:text-primary transition-colors p-1"
                                        aria-label="@($"Focus map on {poi.Name}")"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => HandleFocusClick(poi.Id)">
                                    <span class="material-symbols-outlined text-base" aria-hidden="true">my_location</span>
                                </button>
                                <button class="text-on-surface-variant hover:text-primary transition-colors p-1"
                                        aria-label="@($"Move {poi.Name} to another collection")"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => OpenMoveModal(poi.Id)">
                                    <span class="material-symbols-outlined text-base" aria-hidden="true">drive_file_move</span>
                                </button>
                                <button class="text-on-surface-variant hover:text-error transition-colors p-1"
                                        aria-label="@($"Delete {poi.Name}")"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => HandleDelete(poi.Id)">
                                    <span class="material-symbols-outlined text-base" aria-hidden="true">delete</span>
                                </button>
                            </td>
                        </tr>
                    </Virtualize>
                </tbody>
            </table>
        }
    </div>
</div>

@* Move modal *@
@if (_movePoiId != null)
{
    <div class="fixed inset-0 bg-black/40 z-50 flex items-center justify-center" @onclick="CloseMoveModal">
        <div class="bg-white rounded-xl shadow-2xl w-80 max-h-[60vh] flex flex-col" @onclick:stopPropagation="true">
            <div class="px-4 py-3 border-b border-surface-container-high flex items-center justify-between">
                <span class="font-headline font-bold text-sm">Move to collection</span>
                <button class="p-1 hover:bg-surface-container-low rounded-full" @onclick="CloseMoveModal">
                    <span class="material-symbols-outlined text-base">close</span>
                </button>
            </div>
            <div class="flex-1 overflow-y-auto p-2">
                @if (Collections != null)
                {
                    @foreach (var col in Collections.Where(c => c.Id != GetCollectionId(_movePoiId.Value)))
                    {
                        <button class="w-full text-left px-3 py-2 rounded-lg hover:bg-surface-container-low transition-colors text-sm flex items-center gap-2"
                                @onclick="() => HandleMove(_movePoiId.Value, col.Id)">
                            <span class="w-3 h-3 rounded-full flex-shrink-0" style="background-color: @col.Color"></span>
                            @col.Name
                        </button>
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Poi> Pois { get; set; } = Array.Empty<Poi>();
    [Parameter] public int? SelectedPoiId { get; set; }
    [Parameter] public string? CollectionName { get; set; }
    [Parameter] public IReadOnlyDictionary<int, string>? PoiCollectionNames { get; set; }
    [Parameter] public IReadOnlyDictionary<int, int>? PoiCollectionIds { get; set; }
    [Parameter] public IReadOnlyList<CollectionViewModel>? Collections { get; set; }
    [Parameter] public EventCallback<int> OnPoiSelected { get; set; }
    [Parameter] public EventCallback<int> OnFocusClicked { get; set; }
    [Parameter] public EventCallback<int> OnDeleteClicked { get; set; }
    [Parameter] public EventCallback<(int PoiId, int TargetCollectionId)> OnMoveClicked { get; set; }

    private int? _movePoiId;

    private string? GetCollectionName(int poiId)
    {
        if (CollectionName != null) return CollectionName;
        if (PoiCollectionNames != null && PoiCollectionNames.TryGetValue(poiId, out var name)) return name;
        return null;
    }

    private int GetCollectionId(int poiId)
    {
        if (PoiCollectionIds != null && PoiCollectionIds.TryGetValue(poiId, out var id)) return id;
        return -1;
    }

    private void OpenMoveModal(int poiId) => _movePoiId = poiId;
    private void CloseMoveModal() => _movePoiId = null;

    private async Task HandlePoiClick(int poiId)
    {
        try { await OnPoiSelected.InvokeAsync(poiId); }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"Error selecting POI {poiId}: {ex.Message}"); }
    }

    private async Task HandleFocusClick(int poiId)
    {
        try { await OnFocusClicked.InvokeAsync(poiId); }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"Error focusing POI {poiId}: {ex.Message}"); }
    }

    private async Task HandleDelete(int poiId)
    {
        try { await OnDeleteClicked.InvokeAsync(poiId); }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"Error deleting POI {poiId}: {ex.Message}"); }
    }

    private async Task HandleMove(int poiId, int targetCollectionId)
    {
        _movePoiId = null;
        try { await OnMoveClicked.InvokeAsync((poiId, targetCollectionId)); }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"Error moving POI {poiId}: {ex.Message}"); }
    }
}
