@using LucidCartographer.Data.Entities
@inject IJSRuntime Js

@{
    var selectedCount = Pois.Count(p => _selectedIds.Contains(p.Id));
    var allSelected = Pois.Count > 0 && selectedCount == Pois.Count;
}

<div class="flex flex-col h-full">
    @* Table Header *@
    <div class="flex items-center justify-between px-4 py-2 flex-shrink-0 bg-surface-container-low/50">
        <div class="flex items-center gap-2">
            <span class="font-bold font-headline text-sm">@UiStrings.FilteredResults</span>
            <span class="text-xs text-on-surface-variant bg-surface-container-high px-2 py-0.5 rounded-full" aria-live="polite">@Pois.Count items</span>
            @if (selectedCount > 0)
            {
                <span class="text-xs font-medium text-primary" aria-live="polite">@selectedCount selected</span>
            }
        </div>
        @if (Pois.Any())
        {
            @* Batch operations: act on every checked row. Icons mirror the
               per-row action buttons (move / copy / delete). *@
            <div class="flex items-center gap-1">
                <button class="text-on-surface-variant hover:text-primary transition-colors p-1"
                        aria-label="@(allSelected ? "Deselect all" : "Select all")"
                        title="@(allSelected ? "Deselect all" : "Select all")"
                        @onclick="ToggleSelectAll">
                    <span class="material-symbols-outlined text-base" aria-hidden="true">@(allSelected ? "deselect" : "select_all")</span>
                </button>
                <span class="w-px h-5 bg-surface-container-high mx-0.5" aria-hidden="true"></span>
                <button class="text-on-surface-variant hover:text-primary transition-colors p-1 disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:text-on-surface-variant"
                        aria-label="Move selected to collection"
                        title="Move selected to collection"
                        disabled="@(selectedCount == 0)"
                        @onclick="OpenBatchMove">
                    <span class="material-symbols-outlined text-base" aria-hidden="true">drive_file_move</span>
                </button>
                <button class="text-on-surface-variant hover:text-primary transition-colors p-1 disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:text-on-surface-variant"
                        aria-label="Copy selected to collection"
                        title="Copy selected to collection"
                        disabled="@(selectedCount == 0)"
                        @onclick="OpenBatchCopy">
                    <span class="material-symbols-outlined text-base" aria-hidden="true">content_copy</span>
                </button>
                <button class="text-on-surface-variant hover:text-error transition-colors p-1 disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:text-on-surface-variant"
                        aria-label="Delete selected"
                        title="Delete selected"
                        disabled="@(selectedCount == 0)"
                        @onclick="HandleBatchDelete">
                    <span class="material-symbols-outlined text-base" aria-hidden="true">delete</span>
                </button>
            </div>
        }
    </div>

    @* Table Content *@
    <div class="flex-1 overflow-y-auto" @ref="_scrollContainer">
        @if (!Pois.Any())
        {
            <div class="p-8 text-center text-on-surface-variant text-sm">
                <span class="material-symbols-outlined text-3xl mb-2 block" aria-hidden="true">location_off</span>
                <p>@UiStrings.NoPoiToDisplay</p>
            </div>
        }
        else
        {
            <table class="w-full text-sm" aria-label="Points of interest">
                <thead class="sticky top-0 bg-surface z-10">
                    <tr class="text-left text-xs text-on-surface-variant">
                        <th class="pl-4 pr-1 py-2 font-medium w-8" scope="col" aria-label="Select"></th>
                        <th class="px-4 py-2 font-medium" scope="col">Location Name</th>
                        <th class="px-4 py-2 font-medium" scope="col">Coordinates</th>
                        <th class="px-4 py-2 font-medium" scope="col">Collection</th>
                        <th class="px-4 py-2 font-medium" scope="col">Added</th>
                        <th class="px-4 py-2 font-medium text-right" scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <Virtualize Items="@Pois.ToList()" Context="poi" ItemSize="44">
                        <tr @key="poi.Id"
                            data-poi-id="@poi.Id"
                            class="hover:bg-surface-container-low transition-colors cursor-pointer @(SelectedPoiId == poi.Id ? "bg-surface-container" : "")"
                            @onclick="() => HandlePoiClick(poi.Id)">
                            <td class="pl-4 pr-1 py-2.5" @onclick:stopPropagation="true">
                                <input type="checkbox" class="cursor-pointer accent-primary align-middle"
                                       checked="@_selectedIds.Contains(poi.Id)"
                                       @onchange="() => ToggleSelected(poi.Id)"
                                       @onclick:stopPropagation="true"
                                       aria-label="@($"Select {poi.Name}")" />
                            </td>
                            <td class="px-4 py-2.5">
                                <div class="flex items-center gap-2">
                                    @{
                                        var (icon, iconClass, iconTitle) = poi switch
                                        {
                                            { EnrichmentNeedsManualUrl: true } => ("error", "text-red-500", "Enrichment failed — paste a Google Maps URL"),
                                            { IsEnriched: true } => ("location_on", "text-on-surface-variant", "Enriched"),
                                            _ => ("hourglass_empty", "text-amber-500", "Waiting for enrichment")
                                        };
                                    }
                                    <span class="material-symbols-outlined text-base @iconClass" aria-hidden="true" title="@iconTitle">@icon</span>
                                    <div>
                                        <div class="font-medium">@poi.Name</div>
                                        @if (!string.IsNullOrEmpty(poi.Address))
                                        {
                                            <div class="text-xs text-on-surface-variant">@poi.Address</div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="px-4 py-2.5 text-xs text-on-surface-variant font-mono">
                                @(poi is { Latitude: not null, Longitude: not null } ? $"{poi.Latitude.Value:F4}, {poi.Longitude.Value:F4}" : "—")
                            </td>
                            <td class="px-4 py-2.5">
                                @{ var cns = GetCollectionNames(poi.Id); }
                                @if (cns.Count > 0)
                                {
                                    <div class="flex flex-wrap gap-1">
                                        @foreach (var cn in cns)
                                        {
                                            <span class="text-xs px-2 py-0.5 rounded-full bg-surface-container-high">@cn</span>
                                        }
                                    </div>
                                }
                            </td>
                            <td class="px-4 py-2.5 text-xs text-on-surface-variant">@poi.AddedDate.ToString("MMM dd, yyyy")</td>
                            <td class="px-4 py-2.5 text-right whitespace-nowrap">
                                <a href="@PoiUrlHelper.GetGoogleMapsUrl(poi)"
                                   target="_blank" rel="noopener"
                                   class="text-primary hover:text-primary-container transition-colors p-1 inline-block"
                                   aria-label="@($"Open {poi.Name} in Google Maps")"
                                   title="Open in Google Maps"
                                   @onclick:stopPropagation="true">
                                    <span class="material-symbols-outlined text-base" aria-hidden="true">open_in_new</span>
                                </a>
                                <button class="text-on-surface-variant hover:text-primary transition-colors p-1"
                                        aria-label="@($"Focus map on {poi.Name}")"
                                        title="Focus on map"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => HandleFocusClick(poi.Id)">
                                    <span class="material-symbols-outlined text-base" aria-hidden="true">my_location</span>
                                </button>
                                <button class="text-on-surface-variant hover:text-primary transition-colors p-1"
                                        aria-label="@($"Move {poi.Name} to another collection")"
                                        title="Move to collection"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => OpenMoveModal(poi.Id)">
                                    <span class="material-symbols-outlined text-base" aria-hidden="true">drive_file_move</span>
                                </button>
                                <button class="text-on-surface-variant hover:text-primary transition-colors p-1"
                                        aria-label="@($"Copy {poi.Name} to another collection")"
                                        title="Copy to collection"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => OpenCopyModal(poi.Id)">
                                    <span class="material-symbols-outlined text-base" aria-hidden="true">content_copy</span>
                                </button>
                                <button class="text-on-surface-variant hover:text-error transition-colors p-1"
                                        aria-label="@($"Delete {poi.Name}")"
                                        title="Delete"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => HandleDelete(poi.Id)">
                                    <span class="material-symbols-outlined text-base" aria-hidden="true">delete</span>
                                </button>
                            </td>
                        </tr>
                    </Virtualize>
                </tbody>
            </table>
        }
    </div>
</div>

@* Move / Copy modal (single-POI row action or batch) *@
@if (_modalPoiId != null || _batchMode)
{
    <div class="fixed inset-0 bg-black/40 flex items-center justify-center" style="z-index: 10000;" @onclick="CloseModal">
        <div class="bg-white rounded-xl shadow-2xl w-80 max-h-[60%] flex flex-col" @onclick:stopPropagation="true">
            <div class="px-4 py-3 border-b border-surface-container-high flex items-center justify-between">
                <span class="font-headline font-bold text-sm">
                    @{ var verb = _isCopy ? "Copy" : "Move"; }
                    @(_batchMode ? $"{verb} {Pois.Count(p => _selectedIds.Contains(p.Id))} to collection" : $"{verb} to collection")
                </span>
                <button class="p-1 hover:bg-surface-container-low rounded-full" @onclick="CloseModal">
                    <span class="material-symbols-outlined text-base">close</span>
                </button>
            </div>
            <div class="flex-1 overflow-y-auto p-2">
                @if (Collections != null)
                {
                    @foreach (var col in GetModalCollections())
                    {
                        <button class="w-full text-left px-3 py-2 rounded-lg hover:bg-surface-container-low transition-colors text-sm flex items-center gap-2"
                                @onclick="() => HandleTargetSelected(col.Id)">
                            <span class="w-3 h-3 rounded-full flex-shrink-0" style="background-color: @col.Color"></span>
                            @col.Name
                        </button>
                    }
                }
                <div class="border-t border-surface-container-high mt-1 pt-1">
                    @if (!_showNewCollectionInput)
                    {
                        <button class="w-full text-left px-3 py-2 rounded-lg hover:bg-surface-container-low transition-colors text-sm flex items-center gap-2 text-primary"
                                @onclick="() => { _showNewCollectionInput = true; }">
                            <span class="material-symbols-outlined text-base">add</span>
                            New collection
                        </button>
                    }
                    else
                    {
                        <form class="flex items-center gap-2 px-3 py-2" @onsubmit="HandleCreateAndTarget" @onsubmit:preventDefault>
                            <input @bind="_newCollectionName" placeholder="Collection name"
                                   class="flex-1 text-sm px-2 py-1 border border-surface-container-high rounded-lg focus:ring-2 focus:ring-primary focus:outline-none" />
                            <button type="submit" class="text-primary hover:text-primary-container p-1" aria-label="@(_isCopy ? "Create and copy" : "Create and move")">
                                <span class="material-symbols-outlined text-base">check</span>
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Poi> Pois { get; set; } = [];
    [Parameter] public int? SelectedPoiId { get; set; }
    [Parameter] public string? CollectionName { get; set; }
    [Parameter] public IReadOnlyDictionary<int, IReadOnlyList<string>>? PoiCollectionNames { get; set; }
    [Parameter] public IReadOnlyDictionary<int, IReadOnlyList<int>>? PoiCollectionMemberships { get; set; }
    [Parameter] public IReadOnlyDictionary<int, int>? PoiCollectionIds { get; set; }
    [Parameter] public IReadOnlyList<CollectionDisplayState>? Collections { get; set; }
    [Parameter] public EventCallback<int> OnPoiSelected { get; set; }
    [Parameter] public EventCallback<int> OnFocusClicked { get; set; }
    [Parameter] public EventCallback<int> OnDeleteClicked { get; set; }
    [Parameter] public EventCallback<(int PoiId, int TargetCollectionId)> OnMoveClicked { get; set; }
    [Parameter] public EventCallback<(int PoiId, string NewCollectionName)> OnMoveToNewClicked { get; set; }
    [Parameter] public EventCallback<(int PoiId, int TargetCollectionId)> OnCopyClicked { get; set; }
    [Parameter] public EventCallback<(int PoiId, string NewCollectionName)> OnCopyToNewClicked { get; set; }

    // Batch operations over the checked rows.
    [Parameter] public EventCallback<IReadOnlyList<int>> OnBatchDeleteClicked { get; set; }
    [Parameter] public EventCallback<(IReadOnlyList<int> PoiIds, int TargetCollectionId)> OnBatchMoveClicked { get; set; }
    [Parameter] public EventCallback<(IReadOnlyList<int> PoiIds, string NewCollectionName)> OnBatchMoveToNewClicked { get; set; }
    [Parameter] public EventCallback<(IReadOnlyList<int> PoiIds, int TargetCollectionId)> OnBatchCopyClicked { get; set; }
    [Parameter] public EventCallback<(IReadOnlyList<int> PoiIds, string NewCollectionName)> OnBatchCopyToNewClicked { get; set; }

    private int? _modalPoiId;
    private bool _isCopy;
    private bool _batchMode;
    private bool _showNewCollectionInput;
    private string _newCollectionName = "";
    private ElementReference _scrollContainer;
    private int? _lastScrolledPoiId;

    // POIs the user has checked for a batch operation. Pruned in
    // OnParametersSet so the count/select-all state stays consistent with the
    // rows currently shown (the table only ever acts on what's listed).
    private readonly HashSet<int> _selectedIds = [];

    protected override void OnParametersSet()
    {
        if (_selectedIds.Count == 0)
        {
            return;
        }
        var present = new HashSet<int>(Pois.Count);
        foreach (var p in Pois)
        {
            present.Add(p.Id);
        }
        _selectedIds.RemoveWhere(id => !present.Contains(id));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (SelectedPoiId is not int id || id == _lastScrolledPoiId || Pois.Count == 0)
        {
            return;
        }
        var index = -1;
        for (var i = 0; i < Pois.Count; i++)
        {
            if (Pois[i].Id == id) { index = i; break; }
        }
        if (index < 0) return;
        _lastScrolledPoiId = id;
        try { await Js.InvokeVoidAsync("LucidCartographer.scrollListToPoi", _scrollContainer, id, index, 44); }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"scrollListToIndex failed: {ex.Message}"); }
    }

    private IReadOnlyList<string> GetCollectionNames(int poiId)
    {
        if (CollectionName != null)
        {
            return [CollectionName];
        }

        if (PoiCollectionNames != null && PoiCollectionNames.TryGetValue(poiId, out var names))
        {
            return names;
        }

        return [];
    }

    private IReadOnlyList<int> GetCollectionMemberships(int poiId)
    {
        if (PoiCollectionMemberships != null && PoiCollectionMemberships.TryGetValue(poiId, out var memberships))
        {
            return memberships;
        }

        return [];
    }

    private IEnumerable<CollectionDisplayState> GetModalCollections()
    {
        if (Collections == null)
        {
            return [];
        }

        // Batch mode mixes POIs with differing memberships, so offer every
        // collection. Single copy hides collections the POI already belongs to.
        if (_batchMode)
        {
            return Collections;
        }

        var memberships = GetCollectionMemberships(_modalPoiId!.Value);
        return _isCopy ? Collections.Where(c => !memberships.Contains(c.Id)) : Collections;
    }

    private void OpenMoveModal(int poiId) { _modalPoiId = poiId; _batchMode = false; _isCopy = false; _showNewCollectionInput = false; _newCollectionName = ""; }
    private void OpenCopyModal(int poiId) { _modalPoiId = poiId; _batchMode = false; _isCopy = true; _showNewCollectionInput = false; _newCollectionName = ""; }
    private void CloseModal() { _modalPoiId = null; _batchMode = false; _showNewCollectionInput = false; _newCollectionName = ""; }

    // --- Batch selection ---

    private void ToggleSelected(int poiId)
    {
        if (!_selectedIds.Remove(poiId))
        {
            _selectedIds.Add(poiId);
        }
    }

    private void ToggleSelectAll()
    {
        var allSelected = Pois.Count > 0 && Pois.All(p => _selectedIds.Contains(p.Id));
        foreach (var p in Pois)
        {
            if (allSelected) { _selectedIds.Remove(p.Id); } else { _selectedIds.Add(p.Id); }
        }
    }

    // Only ever act on POIs that are actually listed right now.
    private List<int> CurrentSelectedIds() =>
        Pois.Where(p => _selectedIds.Contains(p.Id)).Select(p => p.Id).ToList();

    private void OpenBatchMove()
    {
        if (CurrentSelectedIds().Count == 0) { return; }
        _batchMode = true; _isCopy = false; _modalPoiId = null; _showNewCollectionInput = false; _newCollectionName = "";
    }

    private void OpenBatchCopy()
    {
        if (CurrentSelectedIds().Count == 0) { return; }
        _batchMode = true; _isCopy = true; _modalPoiId = null; _showNewCollectionInput = false; _newCollectionName = "";
    }

    private async Task HandleBatchDelete()
    {
        var ids = CurrentSelectedIds();
        if (ids.Count == 0) { return; }
        _selectedIds.Clear();
        try { await OnBatchDeleteClicked.InvokeAsync(ids); }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"Batch delete failed: {ex.Message}"); }
    }

    private async Task HandlePoiClick(int poiId)
    {
        _lastScrolledPoiId = poiId;
        try { await OnPoiSelected.InvokeAsync(poiId); }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"Error selecting POI {poiId}: {ex.Message}"); }
    }

    private async Task HandleFocusClick(int poiId)
    {
        try { await OnFocusClicked.InvokeAsync(poiId); }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"Error focusing POI {poiId}: {ex.Message}"); }
    }

    private async Task HandleDelete(int poiId)
    {
        try { await OnDeleteClicked.InvokeAsync(poiId); }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"Error deleting POI {poiId}: {ex.Message}"); }
    }

    private async Task HandleTargetSelected(int targetCollectionId)
    {
        var isCopy = _isCopy;
        if (_batchMode)
        {
            var ids = CurrentSelectedIds();
            CloseModal();
            if (ids.Count == 0) { return; }
            _selectedIds.Clear();
            try
            {
                if (isCopy) { await OnBatchCopyClicked.InvokeAsync((ids, targetCollectionId)); }
                else { await OnBatchMoveClicked.InvokeAsync((ids, targetCollectionId)); }
            }
            catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"Batch {(isCopy ? "copy" : "move")} failed: {ex.Message}"); }
            return;
        }

        var poiId = _modalPoiId!.Value;
        CloseModal();
        try
        {
            if (isCopy)
            {
                await OnCopyClicked.InvokeAsync((poiId, targetCollectionId));
            }
            else
            {
                await OnMoveClicked.InvokeAsync((poiId, targetCollectionId));
            }
        }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"Error {(isCopy ? "copying" : "moving")} POI {poiId}: {ex.Message}"); }
    }

    private async Task HandleCreateAndTarget()
    {
        if (string.IsNullOrWhiteSpace(_newCollectionName))
        {
            return;
        }

        var name = _newCollectionName.Trim();
        var isCopy = _isCopy;

        if (_batchMode)
        {
            var ids = CurrentSelectedIds();
            CloseModal();
            if (ids.Count == 0) { return; }
            _selectedIds.Clear();
            try
            {
                if (isCopy) { await OnBatchCopyToNewClicked.InvokeAsync((ids, name)); }
                else { await OnBatchMoveToNewClicked.InvokeAsync((ids, name)); }
            }
            catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"Batch create-and-{(isCopy ? "copy" : "move")} failed: {ex.Message}"); }
            return;
        }

        if (_modalPoiId == null)
        {
            return;
        }

        var poiId = _modalPoiId.Value;
        CloseModal();
        try
        {
            if (isCopy)
            {
                await OnCopyToNewClicked.InvokeAsync((poiId, name));
            }
            else
            {
                await OnMoveToNewClicked.InvokeAsync((poiId, name));
            }
        }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"Error creating collection and {(isCopy ? "copying" : "moving")} POI {poiId}: {ex.Message}"); }
    }
}
