@using LucidCartographer.Components.Shared.Trip
@implements IDisposable

@* Mobile Trip View toggle. Same semantics as the desktop TripToggle
   (aria-pressed + aria-live announcement) on the mobile render path; ≥44px
   touch target. Lives in the bottom-panel results header. Absent below 2
   placeable POIs. *@

@if (Vm.IsToggleAvailable)
{
    <button type="button"
            role="switch"
            aria-pressed="@(Vm.IsTripViewEnabled ? "true" : "false")"
            aria-label="@UiStrings.TripViewToggleAria"
            @onclick="OnToggleAsync"
            style="display:inline-flex;align-items:center;gap:6px;min-height:44px;min-width:44px;padding:0 12px;background:transparent;border:none;font-weight:600;font-size:13px;@(Vm.IsTripViewEnabled ? "color:var(--primary)" : "color:var(--text-2)")">
        <span class="ms @(Vm.IsTripViewEnabled ? "filled" : "")" style="font-size:18px" aria-hidden="true">route</span>
        @UiStrings.TripView
    </button>
    <span class="sr-only" role="status" aria-live="polite">@Vm.Announcement</span>
}

@code {
    [Parameter, EditorRequired] public TripViewModel Vm { get; set; } = null!;

    protected override void OnInitialized() => Vm.StateChanged += OnVmChanged;

    private void OnVmChanged() => InvokeAsync(StateHasChanged);

    private Task OnToggleAsync() => Vm.ToggleAsync();

    public void Dispose() => Vm.StateChanged -= OnVmChanged;
}
