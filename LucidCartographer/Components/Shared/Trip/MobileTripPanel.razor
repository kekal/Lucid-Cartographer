@implements IDisposable
@using LucidCartographer.Services.Trip


<span class="sr-only" role="status" aria-live="polite">@Vm.SelectionAnnouncement</span>

<span class="sr-only" role="status" aria-live="polite">@Vm.LastReorderAnnouncement</span>

<span class="sr-only" role="status" aria-live="polite">@Vm.StartFinishAnnouncement</span>

<span class="sr-only" role="status" aria-live="polite">@(Vm.IsAnyLegComputing ? UiStrings.TripLegComputingAnnouncement : null)</span>

<div style="display:flex;justify-content:center;padding:8px 12px;border-bottom:1px solid var(--border)">
    <TravelModeSelector Vm="Vm" />
</div>

@if (Vm.OrderedLegs.Count > 0)
{
    <div class="trip-total" style="display:flex;align-items:center;justify-content:space-between;padding:6px 12px;border-bottom:1px solid var(--border)">
        <span class="sub">@UiStrings.TripTotalTravelTimeLabel</span>
        <span class="name" style="text-align:right"
              aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripTotalTravelTimeAria, TravelTimeFormatting.Duration(Vm.TotalTravelTimeSeconds))">
            @TravelTimeFormatting.Duration(Vm.TotalTravelTimeSeconds)
        </span>
    </div>

    <div style="padding:6px 12px;border-bottom:1px solid var(--border);display:flex;gap:16px;align-items:center">
        <button type="button" class="trip-sort-tsp"
                style="font-size:12px;color:var(--primary);background:none;border:none;padding:0;cursor:pointer"
                aria-label="@UiStrings.TripSortTspAria"
                disabled="@Vm.IsAnyLegComputing"
                @onclick="Vm.SortTravelingSalesmanAsync">
            @UiStrings.TripSortTspLabel
        </button>
        <button type="button" class="trip-recompute"
                style="font-size:12px;color:var(--primary);background:none;border:none;padding:0;cursor:pointer"
                aria-label="@UiStrings.TripRecomputeAria"
                disabled="@Vm.IsAnyLegComputing"
                @onclick="Vm.RecomputeTravelTimesAsync">
            @UiStrings.TripRecomputeLabel
        </button>
    </div>
    <span role="status" aria-live="polite" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">@Vm.LastSortAnnouncement</span>
}

@if (Vm.OrderedLegs.Count > 0)
{
    <div class="trip-budget" style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding:6px 12px;border-bottom:1px solid var(--border);font-size:12px">
        <label style="display:flex;align-items:center;gap:6px;color:var(--text-2)">
            <span>@UiStrings.TripStartTimeLabel</span>
            <input type="time"
                   aria-label="@UiStrings.TripStartTimeAria"
                   value="@StartTimeValue()"
                   style="padding:2px 4px;border:1px solid var(--border);border-radius:4px;background:var(--bg-elev-1);color:var(--text-1)"
                   @onchange="OnStartTimeChangedAsync" />
        </label>
        <label style="display:flex;align-items:center;gap:6px;color:var(--text-2)">
            <span>@UiStrings.TripBudgetLabel</span>
            <input type="number" min="0" max="@TripViewModel.MaxBudgetMinutes" inputmode="numeric"
                   placeholder="@UiStrings.TripBudgetPlaceholder"
                   aria-label="@UiStrings.TripBudgetAria"
                   value="@BudgetValue()"
                   style="width:64px;text-align:right;padding:2px 4px;border:1px solid var(--border);border-radius:4px;background:var(--bg-elev-1);color:var(--text-1)"
                   @onchange="OnBudgetChangedAsync" />
        </label>
        @if (Vm.Timeline.IsOverBudget)
        {
            <span class="trip-overrun" role="status" aria-label="@UiStrings.TripBudgetOverrunAria"
                  style="display:inline-flex;align-items:center;gap:4px;padding:2px 6px;border-radius:4px;color:var(--warn);background:var(--warn-soft)">
                <span class="ms" aria-hidden="true" style="font-size:14px">schedule</span>
                @UiStrings.TripBudgetOverrunLabel
            </span>
        }
    </div>
}

@if (Vm.IsShowingApproximateEstimates)
{
    <div role="status" aria-live="polite"
         style="display:flex;align-items:flex-start;gap:6px;padding:6px 12px;border-bottom:1px solid var(--border);background:var(--bg-elev-2);color:var(--text-2);font-size:12px">
        <span class="ms" aria-hidden="true" style="font-size:16px">info</span>
        <span>@UiStrings.TripApproximateEstimatesNote</span>
    </div>
}

<div class="scroll" style="flex:1">
    <div class="list trip-stop-list" aria-label="@UiStrings.TripStopListAria">
        @if (Vm.StopRows.Count == 0)
        {
            <div class="empty">
                <span class="ms" aria-hidden="true">route</span>
                <div class="t">@UiStrings.TripStopListEmpty</div>
            </div>
        }
        else
        {
            @foreach (var row in Vm.StopRows)
            {
                @if (!row.IsPlaceable)
                {
                    <div class="row" @key="row.PoiId" data-poi-id="@row.PoiId"
                         aria-label="@UiStrings.TripStopNotPlaceableAria"
                         title="@UiStrings.TripStopNotPlaceableDetail"
                         style="opacity:.6">
                        <div class="avatar" style="background:var(--bg-elev-2);color:var(--text-2)" aria-hidden="true">
                            <span class="ms">location_off</span>
                        </div>
                        <div class="meta">
                            <div class="name" style="color:var(--text-2)">@row.Name</div>
                            <div class="sub">@UiStrings.TripStopNotPlaceable</div>
                        </div>
                        <input type="number" min="0" max="@TripViewModel.MaxDwellMinutes" inputmode="numeric"
                               class="trailing"
                               placeholder="@UiStrings.TripDwellPlaceholder"
                               aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripDwellAria, row.Name)"
                               value="@DwellMinutes(row)"
                               style="width:56px;text-align:right;padding:2px 4px;border:1px solid var(--border);border-radius:4px;background:var(--bg-elev-1);color:var(--text-1)"
                               @onchange="e => OnDwellMinutesChangedAsync(row.PoiId, e.Value)" />
                    </div>
                }
                else
                {
                    var stop = Vm.OrderedStops.First(s => s.PoiId == row.PoiId);
                    var selected = Vm.SelectedStopPoiId == row.PoiId;
                    var number = row.DisplayOrder!.Value;
                    var role = Vm.StopRole(row.PoiId);
                    <div class="row" @key="row.PoiId" data-poi-id="@row.PoiId"
                         role="button" tabindex="0"
                         aria-current="@(selected ? "true" : null)"
                         aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripStopRowAria, number, Vm.OrderedStops.Count, row.Name)"
                         draggable="true"
                         style="@(selected ? "background:var(--primary-soft)" : "")"
                         @onclick="() => Vm.SelectStop(row.PoiId, TripSelectionSource.List)"
                         @onkeydown="e => OnRowKeyDown(e, row.PoiId)"
                         @ondragstart="() => OnDragStart(row.PoiId)"
                         @ondragover:preventDefault
                         @ondrop="() => OnDropAsync(stop.OrderIndex)"
                         @ondrop:preventDefault
                         @ondragend="OnDragEnd">
                        <span aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripDragHandle, row.Name)"
                              style="display:inline-flex;align-items:center;justify-content:center;min-width:24px;color:var(--text-2);touch-action:none">
                            <span class="ms" aria-hidden="true">drag_indicator</span>
                        </span>
                        <div class="avatar" style="background:var(--primary)@(role == TripStopRole.Start ? ";box-shadow:0 0 0 2px var(--bg-elev-1),0 0 0 4px var(--primary)" : role == TripStopRole.Finish ? ";box-shadow:0 0 0 2px var(--bg-elev-1),0 0 0 4px var(--text-2)" : "")">
                            <StopOrderBadge Number="number" />
                        </div>
                        @if (role != TripStopRole.None)
                        {
                            <span class="ms" role="img"
                                  aria-label="@BadgeAria(role, number)"
                                  title="@BadgeAria(role, number)"
                                  style="min-width:20px;text-align:center;color:@(role == TripStopRole.Start ? "var(--primary)" : "var(--text-2)")">@(role == TripStopRole.Start ? "trip_origin" : "sports_score")</span>
                        }
                        <div class="meta">
                            <div class="name">@row.Name</div>
                            @{ var arrival = ArrivalFor(row.PoiId); }
                            @if (arrival is not null)
                            {
                                <div class="sub trip-arrival" title="@ArrivalText(arrival)"
                                     aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripTimelineArrivalAria, ArrivalText(arrival))">
                                    @ArrivalCompactText(arrival)
                                </div>
                            }
                            @{ var leg = LegFrom(row.PoiId); }
                            @if (leg is not null)
                            {
                                <div class="sub" style="display:flex;align-items:center;gap:6px">
                                    <span aria-label="@(leg.DurationSeconds is null ? UiStrings.TripLegComputingAria : string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripLegTravelTimeAria, TravelTimeFormatting.Duration(leg.DurationSeconds)))">@TravelTimeFormatting.Duration(leg.DurationSeconds)</span>
                                    <span aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripLegDistanceAria, TravelTimeFormatting.Distance(leg.DistanceMeters))" style="opacity:.8">@TravelTimeFormatting.Distance(leg.DistanceMeters)</span>
                                    <FidelityBadge Fidelity="@leg.Fidelity" />
                                    @if (Vm.TravelMode == LucidCartographer.Data.Entities.TravelMode.AnyAir)
                                    {
                                        <input type="number" min="0" max="@TripViewModel.MaxManualLegMinutes" inputmode="numeric"
                                               placeholder="@UiStrings.TripManualMinutesPlaceholder"
                                               aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripManualMinutesAria, row.Name)"
                                               value="@ManualMinutes(leg)"
                                               style="width:56px;text-align:right;padding:2px 4px;border:1px solid var(--border);border-radius:4px;background:var(--bg-elev-1);color:var(--text-1)"
                                               @onchange="e => OnManualMinutesChangedAsync(leg, e.Value)"
                                               @onclick:stopPropagation
                                               @onkeydown:stopPropagation />
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="sub" aria-label="@UiStrings.TripLegNoTravelTimeAria">@UiStrings.TripLegTimeUnknown</div>
                            }
                        </div>
                        <input type="number" min="0" max="@TripViewModel.MaxDwellMinutes" inputmode="numeric"
                               class="trailing"
                               placeholder="@UiStrings.TripDwellPlaceholder"
                               aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripDwellAria, row.Name)"
                               value="@DwellMinutes(row)"
                               style="width:56px;text-align:right;padding:2px 4px;border:1px solid var(--border);border-radius:4px;background:var(--bg-elev-1);color:var(--text-1)"
                               @onchange="e => OnDwellMinutesChangedAsync(row.PoiId, e.Value)"
                               @onclick:stopPropagation
                               @onkeydown:stopPropagation />
                        <span style="display:inline-flex;flex-direction:column;flex-shrink:0">
                            <button type="button"
                                    aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripMoveStopUp, row.Name)"
                                    disabled="@(!Vm.CanMoveUp(stop))"
                                    style="min-width:44px;min-height:44px;background:transparent;border:none;color:var(--text-2);@(Vm.CanMoveUp(stop) ? "" : "opacity:.4")"
                                    @onclick="() => Vm.MoveStopUpAsync(row.PoiId)"
                                    @onclick:stopPropagation
                                    @onkeydown:stopPropagation>
                                <span class="ms" aria-hidden="true">arrow_upward</span>
                            </button>
                            <button type="button"
                                    aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripMoveStopDown, row.Name)"
                                    disabled="@(!Vm.CanMoveDown(stop))"
                                    style="min-width:44px;min-height:44px;background:transparent;border:none;color:var(--text-2);@(Vm.CanMoveDown(stop) ? "" : "opacity:.4")"
                                    @onclick="() => Vm.MoveStopDownAsync(row.PoiId)"
                                    @onclick:stopPropagation
                                    @onkeydown:stopPropagation>
                                <span class="ms" aria-hidden="true">arrow_downward</span>
                            </button>
                        </span>
                        <span style="display:inline-flex;flex-direction:column;flex-shrink:0">
                            <button type="button"
                                    aria-label="@StartControlAria(role, row.Name)"
                                    aria-pressed="@(role == TripStopRole.Start ? "true" : "false")"
                                    disabled="@(!Vm.CanSetStart(row.PoiId))"
                                    style="min-width:44px;min-height:44px;background:transparent;border:none;color:@(role == TripStopRole.Start ? "var(--primary)" : "var(--text-2)");@(Vm.CanSetStart(row.PoiId) ? "" : "opacity:.4")"
                                    @onclick="() => OnStartClickAsync(row.PoiId, role)"
                                    @onclick:stopPropagation
                                    @onkeydown:stopPropagation>
                                <span class="ms" aria-hidden="true">trip_origin</span>
                            </button>
                            <button type="button"
                                    aria-label="@FinishControlAria(role, row.Name)"
                                    aria-pressed="@(role == TripStopRole.Finish ? "true" : "false")"
                                    disabled="@(!Vm.CanSetFinish(row.PoiId))"
                                    style="min-width:44px;min-height:44px;background:transparent;border:none;color:@(role == TripStopRole.Finish ? "var(--primary)" : "var(--text-2)");@(Vm.CanSetFinish(row.PoiId) ? "" : "opacity:.4")"
                                    @onclick="() => OnFinishClickAsync(row.PoiId, role)"
                                    @onclick:stopPropagation
                                    @onkeydown:stopPropagation>
                                <span class="ms" aria-hidden="true">sports_score</span>
                            </button>
                        </span>
                    </div>
                }
            }
        }
    </div>
</div>

@if (Vm.Timeline.FinishOrReturn is { } finish)
{
    <div class="trip-finish" style="display:flex;align-items:center;justify-content:space-between;padding:6px 12px;border-top:1px solid var(--border);font-size:12px">
        <span class="sub">@(Vm.IsRoundtrip ? UiStrings.TripTimelineFinishLabel : UiStrings.TripTimelineFinishOpenLabel)</span>
        <span class="name" style="text-align:right"
              aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripTimelineFinishAria, ArrivalText(finish))">
            @ArrivalText(finish)
        </span>
    </div>
}

@code {
    [Parameter, EditorRequired] public TripViewModel Vm { get; set; } = null!;

    protected override void OnInitialized() => Vm.StateChanged += OnVmChanged;

    private void OnVmChanged() => InvokeAsync(StateHasChanged);

    private TripLeg? LegFrom(int poiId) =>
        Vm.OrderedLegs.FirstOrDefault(l => l.FromPoiId == poiId);

    private ItineraryArrival? ArrivalFor(int poiId) =>
        Vm.Timeline.Stops.FirstOrDefault(a => a.PoiId == poiId);

    private string ArrivalText(ItineraryArrival a) =>
        TravelTimeFormatting.Arrival(a.OffsetSeconds, a.ArrivalWallClock, a.QualifyingFidelity, a.IsUnknown, Vm.TripStartTime);

    private string ArrivalCompactText(ItineraryArrival a) =>
        TravelTimeFormatting.ArrivalCompact(a.OffsetSeconds, a.ArrivalWallClock, a.QualifyingFidelity, a.IsUnknown, Vm.TripStartTime);

    private string StartTimeValue() =>
        Vm.TripStartTime is { } t
            ? t.ToString("HH:mm", System.Globalization.CultureInfo.CurrentCulture)
            : string.Empty;

    private string BudgetValue() =>
        Vm.TimeBudgetMinutes is { } m
            ? m.ToString(System.Globalization.CultureInfo.CurrentCulture)
            : string.Empty;

    private async Task OnStartTimeChangedAsync(ChangeEventArgs e)
    {
        var text = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(text))
        {
            await Vm.SetTripStartTimeAsync(null);
            return;
        }

        if (TimeOnly.TryParse(text, System.Globalization.CultureInfo.CurrentCulture, out var time))
        {
            await Vm.SetTripStartTimeAsync(DateTime.Today.Add(time.ToTimeSpan()));
        }
    }

    private async Task OnBudgetChangedAsync(ChangeEventArgs e)
    {
        var text = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(text))
        {
            await Vm.SetTimeBudgetMinutesAsync(null);
            return;
        }

        if (int.TryParse(text, System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.CurrentCulture, out var minutes) && minutes >= 0)
        {
            await Vm.SetTimeBudgetMinutesAsync(minutes);
        }
    }

    private static string DwellMinutes(TripStopRow row) =>
        row.DwellMinutes is { } m
            ? m.ToString(System.Globalization.CultureInfo.CurrentCulture)
            : string.Empty;

    private async Task OnDwellMinutesChangedAsync(int poiId, object? raw)
    {
        var text = raw?.ToString();
        if (string.IsNullOrWhiteSpace(text))
        {
            await Vm.SetDwellMinutesAsync(poiId, null);
            return;
        }

        if (int.TryParse(text, System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.CurrentCulture, out var minutes) && minutes >= 0)
        {
            await Vm.SetDwellMinutesAsync(poiId, minutes);
        }
    }

    private static string ManualMinutes(TripLeg leg) =>
        leg.Fidelity == LucidCartographer.Data.Entities.Fidelity.Manual && leg.DurationSeconds is { } s
            ? (s / 60).ToString(System.Globalization.CultureInfo.CurrentCulture)
            : string.Empty;

    private async Task OnManualMinutesChangedAsync(TripLeg leg, object? raw)
    {
        var text = raw?.ToString();
        if (string.IsNullOrWhiteSpace(text))
        {
            await Vm.ClearManualLegTimeAsync(leg.FromPoiId, leg.ToPoiId);
            return;
        }

        if (int.TryParse(text, System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.CurrentCulture, out var minutes) && minutes >= 0)
        {
            await Vm.SetManualLegTimeAsync(leg.FromPoiId, leg.ToPoiId, minutes);
        }
    }

    private void OnRowKeyDown(KeyboardEventArgs e, int poiId)
    {
        if (e.Key is "Enter" or " ")
        {
            Vm.SelectStop(poiId, TripSelectionSource.List);
        }
    }

    private int? _draggedPoiId;

    private void OnDragStart(int poiId) => _draggedPoiId = poiId;

    private void OnDragEnd() => _draggedPoiId = null;

    private async Task OnDropAsync(int targetOrderIndex)
    {
        if (_draggedPoiId is not { } poiId)
        {
            return;
        }

        _draggedPoiId = null;
        await Vm.MoveStopToAsync(poiId, targetOrderIndex);
    }

    private Task OnStartClickAsync(int poiId, TripStopRole role) =>
        role == TripStopRole.Start ? Vm.ClearStartAsync() : Vm.SetStartAsync(poiId);

    private Task OnFinishClickAsync(int poiId, TripStopRole role) =>
        role == TripStopRole.Finish ? Vm.ClearFinishAsync() : Vm.SetFinishAsync(poiId);

    private string BadgeAria(TripStopRole role, int number) => role switch
    {
        TripStopRole.Start => string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripStartBadgeAria, Vm.OrderedStops.Count),
        TripStopRole.Finish => string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripFinishBadgeAria, Vm.OrderedStops.Count),
        _ => string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripStopBadgeAria, number, Vm.OrderedStops.Count),
    };

    private static string StartControlAria(TripStopRole role, string name) =>
        string.Format(System.Globalization.CultureInfo.CurrentCulture,
            role == TripStopRole.Start ? UiStrings.TripUnsetStart : UiStrings.TripSetAsStart, name);

    private static string FinishControlAria(TripStopRole role, string name) =>
        string.Format(System.Globalization.CultureInfo.CurrentCulture,
            role == TripStopRole.Finish ? UiStrings.TripUnsetFinish : UiStrings.TripSetAsFinish, name);

    public void Dispose() => Vm.StateChanged -= OnVmChanged;
}
