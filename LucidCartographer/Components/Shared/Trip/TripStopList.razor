@implements IDisposable
@using LucidCartographer.Services.Trip

@* Desktop Trip View stop-list panel (Story 1.3, AC2). Markup + a ~12-line VM
   bridge only — all leg/stop projection logic lives in TripViewModel. Shown
   beside the map when Trip View is on. Rows echo PoiTable's rhythm but are
   trip-scoped: [drag-handle gutter (Story 1.5)] · [order badge] · [POI name] ·
   [dwell-time placeholder] · [timeline-value placeholder]. The dwell + timeline
   values are inert "—" placeholders here; the real values arrive in Epic 2. *@

<section class="flex flex-col h-full bg-surface-container-low border-l border-surface-container-high"
         aria-label="@UiStrings.TripStopListAria">
    <header class="flex items-center justify-between px-3 py-2 border-b border-surface-container-high flex-shrink-0">
        <span class="text-sm font-semibold text-on-surface">@UiStrings.TripStopList</span>
        @* aria-live announces the stop count as it changes (seed / reorder /
           membership). The live region's announced string is its text content —
           the visible numeral is aria-hidden and an sr-only child carries the
           full localized phrase (e.g. "3 stop trip"), rather than an aria-label
           that competes with the text node on a live region. *@
        <span class="text-xs text-on-surface-variant" role="status" aria-live="polite">
            <span aria-hidden="true">@Vm.OrderedStops.Count</span>
            <span class="sr-only">@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripStopCountAria, Vm.OrderedStops.Count)</span>
        </span>
    </header>

    @* Story 3.4 (FR-23): the trip-wide TravelModeSelector is REMOVED from the desktop
       surface — per-leg modes (the LegModePill on each connector) replace it, so the
       trip-level selector is a dead duplicate. (Mobile keeps its selector for now —
       the per-leg mirror is a deferred phase.) *@

    @* TRIP-TRAVELTIME-01 (AC5): trip total travel time, rendered once. A partial
       trip (any uncomputed leg) shows the em-dash — no false precision. *@
    @if (Vm.OrderedLegs.Count > 0)
    {
        <div class="flex items-center justify-between px-3 py-1.5 border-b border-surface-container-high flex-shrink-0 text-xs">
            <span class="text-on-surface-variant">@UiStrings.TripTotalTravelTimeLabel</span>
            <span class="font-semibold text-on-surface"
                  aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripTotalTravelTimeAria, TravelTimeFormatting.Duration(Vm.TotalTravelTimeSeconds))">
                @TravelTimeFormatting.Duration(Vm.TotalTravelTimeSeconds)
            </span>
        </div>

        @* TRIP-RECOMPUTE-01 (Story 2.4, AC4): explicit on-demand recompute. Kept in
           the header area, NOT inside the clickable stop rows (a wide element over
           the row centre breaks Playwright row selection — 2.2 regression). *@
        <div class="px-3 py-1.5 border-b border-surface-container-high flex-shrink-0 flex items-center gap-4">
            @* TRIP-TSP-01 (Story 3.1, AR-6): explicit on-demand TSP-Sort. On-demand
               only — never fires automatically. Disabled while legs are computing so
               the matrix sorts over settled travel times. *@
            <button type="button"
                    class="text-xs text-primary hover:underline disabled:opacity-50 disabled:no-underline"
                    aria-label="@UiStrings.TripSortTspAria"
                    title="@UiStrings.TripSortTspAria"
                    disabled="@Vm.IsAnyLegComputing"
                    @onclick="Vm.SortTravelingSalesmanAsync">
                @UiStrings.TripSortTspLabel
            </button>
            <button type="button"
                    class="text-xs text-primary hover:underline disabled:opacity-50 disabled:no-underline"
                    aria-label="@UiStrings.TripRecomputeAria"
                    title="@UiStrings.TripRecomputeAria"
                    disabled="@Vm.IsAnyLegComputing"
                    @onclick="Vm.RecomputeTravelTimesAsync">
                @UiStrings.TripRecomputeLabel
            </button>
        </div>
        @* TRIP-TSP-01: polite live region announcing a completed sort. *@
        <span class="sr-only" role="status" aria-live="polite">@Vm.LastSortAnnouncement</span>
    }

    @* TRIP-TIMELINE-01 (Story 2.6, AC2/AC5): header inputs for the wall-clock trip
       start time + the soft time budget (minutes), and the soft AMBER overrun flag.
       Kept in the header — NOT in the clickable stop rows (the 2.2/2.5 width lesson).
       The overrun is a soft warn (warn/amber convention), never tertiary/red, and is
       shown only when the KNOWN total exceeds the set budget. *@
    @if (Vm.OrderedLegs.Count > 0)
    {
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 px-3 py-1.5 border-b border-surface-container-high flex-shrink-0 text-xs min-w-0">
            <label class="flex items-center gap-1 text-on-surface-variant min-w-0">
                <span class="flex-shrink-0">@UiStrings.TripStartTimeLabel</span>
                <input type="datetime-local"
                       class="min-w-0 w-auto text-xs px-1 py-0.5 rounded border border-surface-container-high bg-surface-container-low text-on-surface"
                       aria-label="@UiStrings.TripStartTimeAria"
                       value="@StartTimeValue()"
                       @onchange="OnStartTimeChangedAsync" />
            </label>
            <label class="flex items-center gap-1 text-on-surface-variant min-w-0">
                <span class="flex-shrink-0">@UiStrings.TripBudgetLabel</span>
                <input type="number" min="0" max="@TripViewModel.MaxBudgetMinutes" inputmode="numeric"
                       class="w-12 text-xs text-right px-1 py-0.5 rounded border border-surface-container-high bg-surface-container-low text-on-surface"
                       placeholder="@UiStrings.TripBudgetPlaceholder"
                       aria-label="@UiStrings.TripBudgetAria"
                       value="@BudgetValue()"
                       @onchange="OnBudgetChangedAsync" />
            </label>
            @if (Vm.Timeline.IsOverBudget)
            {
                @* Soft amber (warn) overrun — the project's muted amber soft-state tone
                   (text-amber-600, as used elsewhere), on a neutral surface chip. NEVER
                   tertiary/red. There is no `warn` Tailwind token (2.3 finding). *@
                <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-amber-600 bg-surface-container"
                      role="status" aria-label="@UiStrings.TripBudgetOverrunAria">
                    <span class="material-symbols-outlined" style="font-size:14px" aria-hidden="true">schedule</span>
                    @UiStrings.TripBudgetOverrunLabel
                </span>
            }
        </div>
    }

    @* TRIP-TRAVELTIME-01 (AC6): announce the computing state while legs await the
       background provider. Resolves to empty once every leg has a cache row. *@
    <span class="sr-only" role="status" aria-live="polite">@(Vm.IsAnyLegComputing ? UiStrings.TripLegComputingAnnouncement : null)</span>

    @* TRIP-DEGRADE-01 (Story 2.3, AC2): honest approximate note when any leg fell
       back to a straight-line estimate (the routing engine was unreachable). In a
       role=status aria-live region so AT hears it; warn/muted tone, never error-red
       (UX-DR10 — a soft honest state, not an error). Kept in the panel header area,
       NOT inside the clickable stop rows (a wide element over the row centre breaks
       row selection — 2.2 regression). *@
    @if (Vm.IsShowingApproximateEstimates)
    {
        <div class="flex items-start gap-1.5 px-3 py-1.5 border-b border-surface-container-high flex-shrink-0 text-xs text-on-surface-variant bg-surface-container"
             role="status" aria-live="polite">
            <span class="material-symbols-outlined flex-shrink-0" style="font-size:16px" aria-hidden="true">info</span>
            <span>@UiStrings.TripApproximateEstimatesNote</span>
        </div>
    }
    @* Story 2.4 (FR-8/10, RD11): the quiet OSRM-recommendation note on a default
       deployment (no measured provider) producing normal straight-line Estimated legs.
       Mirrors the fallback note's quiet/muted token styling + info glyph + role=status
       aria-live, but is a DIFFERENT state (a normal Mock estimate, not an engine
       failure). Rendered mutually exclusive with the fallback note above — when the
       trip is in the engine-unreachable fallback state that note wins — so the two
       contextual notes never appear together (FR-8 "distinct from the fallback note").
       Guidance only: links to docs/osrm.md; it does not stand up/configure OSRM. *@
    @if (Vm.RecommendsOsrm && !Vm.IsShowingApproximateEstimates)
    {
        @* Persistent contextual hint (the deployment is on the default Mock provider),
           NOT a transient state change — so it is read in normal document flow, NOT a
           role=status/aria-live region (which would re-announce on unrelated re-renders).
           The transient engine-unreachable fallback note above keeps its live region. *@
        <div class="flex items-start gap-1.5 px-3 py-1.5 border-b border-surface-container-high flex-shrink-0 text-xs text-on-surface-variant bg-surface-container">
            <span class="material-symbols-outlined flex-shrink-0" style="font-size:16px" aria-hidden="true">info</span>
            <span>
                @UiStrings.TripMockEstimateNote
                <a href="@UiStrings.TripMockEstimateOsrmHref" target="_blank" rel="noopener"
                   class="text-primary hover:underline">@UiStrings.TripMockEstimateOsrmLink</a>
            </span>
        </div>
    }

    @* TRIP-SELECT-05: announces the selected stop (list→map or map→list). *@
    <span class="sr-only" role="status" aria-live="polite">@Vm.SelectionAnnouncement</span>

    @* TRIP-ORDER-03: announces every successful reorder ("X moved to stop 2 of 5")
       — one visually-hidden polite region per stop-list surface (NFR4 / AR-9). *@
    <span class="sr-only" role="status" aria-live="polite">@Vm.LastReorderAnnouncement</span>

    @* TRIP-STARTFINISH-05: announces Start/Finish designation changes and the
       roundtrip ↔ open-path shape transitions ("Open path — ends at X"). *@
    <span class="sr-only" role="status" aria-live="polite">@Vm.StartFinishAnnouncement</span>

    @if (Vm.StopRows.Count == 0)
    {
        <div class="px-3 py-4 text-sm text-on-surface-variant">@UiStrings.TripStopListEmpty</div>
    }
    else
    {
        @* Story 1.2 (FR-2/11/12): a WIDE, full-width, column-ALIGNED trip-scoped
           table. Every row shares ONE CSS-grid template (GridTemplate) so the seven
           columns — reorder gutter · stop-# badge · name · dwell · arrival ·
           start/finish · actions — line up across every row state (placeable,
           unplaceable, pinned Start/Finish, dwell set/empty, long/short names).
           Rendered as <li> rows (no <table> — the desktop-takeover tests assert no
           <table> when Trip View is on) inside the <ul> that scopes the JS
           scroll-into-view helper (TRIP-SELECT-05). Per-leg travel info is NOT a row
           column: it renders as an interim single-line connector BETWEEN consecutive
           rows (Story 1.3 turns it into the real LegConnector). *@
        <ul class="flex-1 overflow-y-auto trip-stop-list" aria-label="@UiStrings.TripStopListAria">
            @for (var index = 0; index < Vm.StopRows.Count; index++)
            {
                var row = Vm.StopRows[index];
                @if (!row.IsPlaceable)
                {
                    @* [TRIP-PLACE-04] "Not placeable" row (UX-DR10/UX-DR11): kept in
                       the list — never dropped — but de-emphasized, NOT selectable
                       (no marker to pan to). Uses the SAME grid template so its
                       columns align with the placeable rows; the not-placeable marker
                       fills the badge slot and the "Not placeable" note sits in the
                       arrival slot. *@
                    <li @key="row.PoiId" data-poi-id="@row.PoiId"
                        aria-label="@UiStrings.TripStopNotPlaceableAria"
                        title="@UiStrings.TripStopNotPlaceableDetail"
                        style="display:grid;grid-template-columns:@GridTemplate;align-items:center"
                        class="gap-2 px-2 py-2 border-b border-surface-container opacity-60">
                        @* Reorder gutter — empty (unplaceable rows don't reorder). *@
                        <span aria-hidden="true"></span>
                        @* Not-placeable marker in the badge slot — outlined, muted,
                           no number (explicit empty markers are first-class). *@
                        <span class="inline-flex items-center justify-center w-5 h-5 rounded-full border border-on-surface-variant text-on-surface-variant text-xs"
                              aria-hidden="true">—</span>
                        @* Name column — full name (no truncation) + address sub-line
                           + enrichment icon, identical shape to the placeable row. *@
                        <div class="min-w-0">
                            <div class="flex items-center gap-1.5 min-w-0">
                                @{ var (uIcon, uIconClass, uIconTitle) = EnrichmentIcon(row); }
                                <span class="material-symbols-outlined text-base @uIconClass flex-shrink-0" aria-hidden="true" title="@uIconTitle">@uIcon</span>
                                <span class="text-sm text-on-surface-variant break-words" title="@row.Name">@row.Name</span>
                            </div>
                            @if (!string.IsNullOrEmpty(row.Address))
                            {
                                <div class="text-xs text-on-surface-variant break-words">@row.Address</div>
                            }
                        </div>
                        @* TRIP-DWELL-01 (Story 2.5, AC4): an unplaceable stop has no
                           travel time but still carries dwell. The row is not
                           selectable, so no stopPropagation is needed here. *@
                        <input type="number" min="0" max="@TripViewModel.MaxDwellMinutes" inputmode="numeric"
                               class="w-12 text-xs text-right px-1 py-0.5 rounded border border-surface-container-high bg-surface-container-low text-on-surface"
                               placeholder="@UiStrings.TripDwellPlaceholder"
                               aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripDwellAria, row.Name)"
                               value="@DwellMinutes(row)"
                               @onchange="e => OnDwellMinutesChangedAsync(row.PoiId, e.Value)" />
                        @* Arrival slot — the unplaceable note (no routed arrival). *@
                        <span class="text-xs text-on-surface-variant">@UiStrings.TripStopNotPlaceable</span>
                        @* Start/Finish slot — empty (unplaceable rows can't be pinned). *@
                        <span aria-hidden="true"></span>
                        @* Actions slot — empty for an unplaceable row. *@
                        <span aria-hidden="true"></span>
                    </li>
                }
                else
                {
                    var stop = Vm.OrderedStops.First(s => s.PoiId == row.PoiId);
                    var selected = Vm.SelectedStopPoiId == row.PoiId;
                    var number = row.DisplayOrder!.Value;
                    var role = Vm.StopRole(row.PoiId);
                    var arrival = ArrivalFor(row.PoiId);
                    @* TRIP-SELECT-05: selectable row — click / Enter / Space select the
                       stop (list→map). data-poi-id lets the scroll helper locate it on
                       the map→list direction. Selected rows get a primary-token ring +
                       tint and expose aria-current to AT (AC3). The shared grid template
                       keeps the seven columns aligned across every row state (FR-11/12). *@
                    <li @key="row.PoiId" data-poi-id="@row.PoiId"
                        role="button" tabindex="0"
                        aria-current="@(selected ? "true" : null)"
                        aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripStopRowAria, number, Vm.OrderedStops.Count, row.Name)"
                        draggable="true"
                        @onclick="() => Vm.SelectStop(row.PoiId, TripSelectionSource.List)"
                        @onkeydown="e => OnRowKeyDown(e, row.PoiId)"
                        @ondragstart="() => OnDragStart(row.PoiId)"
                        @ondragover:preventDefault
                        @ondrop="() => OnDropAsync(stop.OrderIndex)"
                        @ondrop:preventDefault
                        @ondragend="OnDragEnd"
                        style="display:grid;grid-template-columns:@GridTemplate;align-items:center"
                        class="gap-2 px-2 py-2 border-b border-surface-container cursor-pointer @(selected ? "bg-primary/10 ring-1 ring-inset ring-primary" : "hover:bg-surface-container")">
                        @* COLUMN 1 — reorder gutter: drag handle (⠿) + ▲▼ move buttons.
                           TRIP-ORDER-04: the whole row is draggable (native HTML5 DnD);
                           the handle is the visual + accessible affordance. TRIP-ORDER-03:
                           the ▲▼ are real Tab-reachable buttons, disabled at the pin-aware
                           window edges; both stopPropagation so reordering never selects. *@
                        <span class="flex items-center gap-0.5">
                            <span class="cursor-grab text-on-surface-variant select-none"
                                  aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripDragHandle, row.Name)"
                                  title="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripDragHandle, row.Name)">
                                <span aria-hidden="true">⠿</span>
                            </span>
                            <span class="flex flex-col">
                                <button type="button"
                                        class="inline-flex items-center justify-center w-5 h-5 rounded text-on-surface-variant enabled:hover:bg-surface-container-high disabled:opacity-40"
                                        aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripMoveStopUp, row.Name)"
                                        title="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripMoveStopUp, row.Name)"
                                        disabled="@(!Vm.CanMoveUp(stop))"
                                        @onclick="() => Vm.MoveStopUpAsync(row.PoiId)"
                                        @onclick:stopPropagation
                                        @onkeydown:stopPropagation>
                                    <span aria-hidden="true">▲</span>
                                </button>
                                <button type="button"
                                        class="inline-flex items-center justify-center w-5 h-5 rounded text-on-surface-variant enabled:hover:bg-surface-container-high disabled:opacity-40"
                                        aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripMoveStopDown, row.Name)"
                                        title="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripMoveStopDown, row.Name)"
                                        disabled="@(!Vm.CanMoveDown(stop))"
                                        @onclick="() => Vm.MoveStopDownAsync(row.PoiId)"
                                        @onclick:stopPropagation
                                        @onkeydown:stopPropagation>
                                    <span aria-hidden="true">▼</span>
                                </button>
                            </span>
                        </span>
                        @* COLUMN 2 — Stop # badge with Start/Finish ring + glyph.
                           Primary-filled numbered circle (UX-DR2); the descriptive
                           "Stop X of Y" label conveys the position. A pinned Start
                           carries a distinct primary ring + trip_origin glyph, a Finish
                           a muted ring + sports_score glyph (TRIP-STARTFINISH-03). *@
                        <span class="flex items-center gap-1">
                            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-primary text-on-primary text-xs font-bold flex-shrink-0@(role == TripStopRole.Start ? " ring-2 ring-primary ring-offset-1" : role == TripStopRole.Finish ? " ring-2 ring-on-surface-variant ring-offset-1" : "")"
                                  aria-label="@BadgeAria(role, number)">
                                <span aria-hidden="true">@number</span>
                            </span>
                            @if (role == TripStopRole.Start)
                            {
                                <span class="material-symbols-outlined text-primary flex-shrink-0" style="font-size:16px" aria-hidden="true">trip_origin</span>
                            }
                            else if (role == TripStopRole.Finish)
                            {
                                <span class="material-symbols-outlined text-on-surface-variant flex-shrink-0" style="font-size:16px" aria-hidden="true">sports_score</span>
                            }
                        </span>
                        @* COLUMN 3 — Name: the FULL POI name (UX-DR1, never truncated to
                           an unreadable width — it wraps in the wide space) + the muted
                           address sub-line (only when present) + the enrichment-state
                           icon (mirrors PoiTable's mapping). *@
                        <div class="min-w-0">
                            <div class="flex items-center gap-1.5 min-w-0">
                                @{ var (icon, iconClass, iconTitle) = EnrichmentIcon(row); }
                                <span class="material-symbols-outlined text-base @iconClass flex-shrink-0" aria-hidden="true" title="@iconTitle">@icon</span>
                                <span class="text-sm font-medium text-on-surface break-words" title="@row.Name">@row.Name</span>
                            </div>
                            @if (!string.IsNullOrEmpty(row.Address))
                            {
                                <div class="text-xs text-on-surface-variant break-words">@row.Address</div>
                            }
                        </div>
                        @* COLUMN 4 — Dwell input (TRIP-DWELL-01). type=number stays here
                           (the HH:MM picker is Story 4.4). stopPropagation so editing
                           never selects/reorders the row (2.2 selection lesson). *@
                        <input type="number" min="0" max="@TripViewModel.MaxDwellMinutes" inputmode="numeric"
                               class="w-12 text-xs text-right px-1 py-0.5 rounded border border-surface-container-high bg-surface-container-low text-on-surface"
                               placeholder="@UiStrings.TripDwellPlaceholder"
                               aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripDwellAria, row.Name)"
                               value="@DwellMinutes(row)"
                               @onchange="e => OnDwellMinutesChangedAsync(row.PoiId, e.Value)"
                               @onclick:stopPropagation
                               @onkeydown:stopPropagation />
                        @* COLUMN 5 — Arrival (TRIP-TIMELINE-01): the per-stop honest
                           arrival (relative offset always). Stays a row column. In the
                           wide region it can show the fuller ArrivalText. *@
                        <span class="text-xs text-on-surface-variant text-right">
                            @if (arrival is not null)
                            {
                                @* The VISIBLE value keeps the compact form (it carries the
                                   honest "~" approximation marker over an Estimated leg —
                                   never a clean, confident offset; TRIP-TIMELINE-01); the
                                   fuller ArrivalText (with the qualifier word) sits in the
                                   title + aria-label, which the wide region has room for. *@
                                <span title="@ArrivalText(arrival)"
                                      aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripTimelineArrivalAria, ArrivalText(arrival))">
                                    @ArrivalCompactText(arrival)
                                </span>
                            }
                            else
                            {
                                <span aria-label="@UiStrings.TripLegNoTravelTimeAria">@UiStrings.TripLegTimeUnknown</span>
                            }
                        </span>
                        @* COLUMN 6 — Start/Finish controls (TRIP-STARTFINISH-04): ○/⚑
                           buttons, aria-pressed reflects the pinned state, disabled on the
                           opposite pin; stopPropagation so designating never selects. *@
                        <span class="flex items-center gap-0.5">
                            <button type="button"
                                    class="inline-flex items-center justify-center w-6 h-6 rounded enabled:hover:bg-surface-container-high disabled:opacity-40 @(role == TripStopRole.Start ? "text-primary" : "text-on-surface-variant")"
                                    aria-label="@StartControlAria(role, row.Name)"
                                    title="@StartControlAria(role, row.Name)"
                                    aria-pressed="@(role == TripStopRole.Start ? "true" : "false")"
                                    disabled="@(!Vm.CanSetStart(row.PoiId))"
                                    @onclick="() => OnStartClickAsync(row.PoiId, role)"
                                    @onclick:stopPropagation
                                    @onkeydown:stopPropagation>
                                <span class="material-symbols-outlined" style="font-size:18px" aria-hidden="true">trip_origin</span>
                            </button>
                            <button type="button"
                                    class="inline-flex items-center justify-center w-6 h-6 rounded enabled:hover:bg-surface-container-high disabled:opacity-40 @(role == TripStopRole.Finish ? "text-primary" : "text-on-surface-variant")"
                                    aria-label="@FinishControlAria(role, row.Name)"
                                    title="@FinishControlAria(role, row.Name)"
                                    aria-pressed="@(role == TripStopRole.Finish ? "true" : "false")"
                                    disabled="@(!Vm.CanSetFinish(row.PoiId))"
                                    @onclick="() => OnFinishClickAsync(row.PoiId, role)"
                                    @onclick:stopPropagation
                                    @onkeydown:stopPropagation>
                                <span class="material-symbols-outlined" style="font-size:18px" aria-hidden="true">sports_score</span>
                            </button>
                        </span>
                        @* COLUMN 7 — Actions: Focus on map + Open in Google Maps ONLY
                           (FR-2; mirrors PoiTable:133-148). No select/coords/collection/
                           added-date/move/copy/delete. Both stopPropagation. *@
                        <span class="flex items-center justify-end gap-0.5">
                            <button type="button"
                                    class="inline-flex items-center justify-center w-7 h-7 rounded text-on-surface-variant hover:text-primary hover:bg-surface-container-high"
                                    aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripFocusOnMapAria, row.Name)"
                                    title="@UiStrings.TripFocusOnMap"
                                    @onclick="() => OnFocusClickAsync(row.PoiId)"
                                    @onclick:stopPropagation
                                    @onkeydown:stopPropagation>
                                <span class="material-symbols-outlined text-base" aria-hidden="true">my_location</span>
                            </button>
                            <a href="@row.GoogleMapsUrl" target="_blank" rel="noopener"
                               class="inline-flex items-center justify-center w-7 h-7 rounded text-primary hover:bg-surface-container-high"
                               aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripOpenInGoogleMapsAria, row.Name)"
                               title="@UiStrings.TripOpenInGoogleMaps"
                               @onclick:stopPropagation>
                                <span class="material-symbols-outlined text-base" aria-hidden="true">open_in_new</span>
                            </a>
                        </span>
                    </li>
                }

                @* Story 1.3 (FR-3, AC1/AC2): the inter-row LegConnector renders the
                   per-leg travel time/distance/fidelity (+ Any/Air manual entry +
                   Manual-leg reset) on the shared edge between consecutive rows.
                   Keyed off the row's DEPARTING leg (LegFrom) — so the CLOSING leg
                   (FromPoiId == last stop) naturally renders AFTER the last row and,
                   since the finish/return footer sits OUTSIDE this <ul>, BEFORE that
                   footer (AC2). Wrapped in a plain <li> with NO data-poi-id so the list
                   nesting is valid (no bare <div> child of <ul> — the Story-1.2 wart) and
                   the row-count assertions that filter on li[data-poi-id] stay intact.
                   NOT aria-hidden: the connector carries meaningful time/distance/fidelity
                   and focusable controls (reset, manual input) that must stay in the
                   accessibility tree (NFR7); its glyphs are individually aria-hidden. *@
                var connectorLeg = LegFrom(row.PoiId);
                @if (connectorLeg is not null)
                {
                    <li>
                        <LegConnector Leg="connectorLeg" Vm="Vm" />
                    </li>
                }
            }
        </ul>
    }

    @* TRIP-TIMELINE-01 (Story 2.6, AC2): the finish/return readout at the END of the
       list — the return-to-Start arrival on a Roundtrip, or the Finish arrival on an
       open path — qualified, or "—" when unknown. *@
    @if (Vm.Timeline.FinishOrReturn is { } finish)
    {
        <div class="flex items-center justify-between px-3 py-1.5 border-t border-surface-container-high flex-shrink-0 text-xs">
            <span class="text-on-surface-variant">@(Vm.IsRoundtrip ? UiStrings.TripTimelineFinishLabel : UiStrings.TripTimelineFinishOpenLabel)</span>
            <span class="font-semibold text-on-surface whitespace-nowrap"
                  aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripTimelineFinishAria, ArrivalText(finish))">
                @ArrivalText(finish)
            </span>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public TripViewModel Vm { get; set; } = null!;

    // Story 1.2 (FR-2, "Focus on map"): map-focus parity with the plain PoiTable.
    // MapPage wires this to the SAME handler PoiTable uses (Vm.HandleFocusPoiAsync on
    // the MapPageViewModel) so the Trip list pans the map identically. When unwired
    // (e.g. a bUnit render without a host), the Focus button falls back to selecting
    // the stop (TripSelectionSource.List), which MapPage's selection sync already pans.
    [Parameter] public EventCallback<int> OnFocusClicked { get; set; }

    // Story 1.2 (FR-11/12): the single shared CSS-grid column template applied to
    // every row (placeable, unplaceable, pinned, long/short name) so the seven
    // columns — reorder gutter · stop-# badge · name · dwell · arrival ·
    // start/finish · actions — line up across all row states. The name column flexes
    // (1fr, min 0) so the full name has room without starving the fixed control
    // columns; everything else is content-sized.
    private const string GridTemplate =
        "auto auto minmax(0,1fr) auto auto auto auto";

    protected override void OnInitialized() => Vm.StateChanged += OnVmChanged;

    private void OnVmChanged() => InvokeAsync(StateHasChanged);

    // TRIP-TRAVELTIME-01: the leg departing a given stop (from this stop to the
    // next, or the roundtrip closing leg from the last stop back to the Start).
    private TripLeg? LegFrom(int poiId) =>
        Vm.OrderedLegs.FirstOrDefault(l => l.FromPoiId == poiId);

    // Story 1.2 (FR-2): the enrichment-state icon for the Name column. Mirrors
    // PoiTable.razor:100-107 exactly — error/red when manual URL is needed,
    // location_on/muted when enriched, else hourglass_empty/amber. All titles via
    // UiStrings (the projection carries the flags; the component holds no Poi logic).
    private static (string Icon, string Class, string Title) EnrichmentIcon(TripStopRow row) => row switch
    {
        { EnrichmentNeedsManualUrl: true } => ("error", "text-red-500", UiStrings.TripEnrichmentFailed),
        { IsEnriched: true } => ("location_on", "text-on-surface-variant", UiStrings.TripEnrichmentEnriched),
        _ => ("hourglass_empty", "text-amber-500", UiStrings.TripEnrichmentWaiting),
    };

    // Story 1.2 (FR-2, "Focus on map"): prefer the host-wired map-focus parity
    // callback (Vm.HandleFocusPoiAsync on MapPageViewModel via MapPage). When it is
    // not wired, fall back to selecting the stop — MapPage's selection sync pans the
    // map to a List selection, so the map still focuses the stop.
    private async Task OnFocusClickAsync(int poiId)
    {
        if (OnFocusClicked.HasDelegate)
        {
            await OnFocusClicked.InvokeAsync(poiId);
        }
        else
        {
            Vm.SelectStop(poiId, TripSelectionSource.List);
        }
    }

    // TRIP-TIMELINE-01 (Story 2.6): the per-stop arrival for a row's PoiId, or null
    // (an unplaceable row has no routed arrival). The first matching routed-stop
    // arrival — the routed sequence holds one arrival per placeable stop in order.
    private ItineraryArrival? ArrivalFor(int poiId) =>
        Vm.Timeline.Stops.FirstOrDefault(a => a.PoiId == poiId);

    // TRIP-TIMELINE-01: the UI-edge display string for an arrival (offset always,
    // wall-clock only with a start time, qualified, or "—" unknown). Single formatter.
    private static string ArrivalText(ItineraryArrival a) =>
        TravelTimeFormatting.Arrival(a.OffsetSeconds, a.ArrivalWallClock, a.QualifyingFidelity, a.IsUnknown);

    // TRIP-TIMELINE-01: the COMPACT row variant (no verbose qualifier word) — keeps the
    // cramped w-64 row's name span from collapsing. The full text is in the title/aria.
    private static string ArrivalCompactText(ItineraryArrival a) =>
        TravelTimeFormatting.ArrivalCompact(a.OffsetSeconds, a.ArrivalWallClock, a.QualifyingFidelity, a.IsUnknown);

    // Story 4.1 (FR-26, RD10): the <input type="datetime-local"> value for the active
    // start. The control's value attribute is ISO/invariant ("yyyy-MM-ddTHH:mm")
    // regardless of locale — this is the wire format, NOT display formatting (4.2 owns
    // locale-driven arrival display). Empty when no start is set.
    private string StartTimeValue() =>
        Vm.TripStartTime is { } t
            ? t.ToString("yyyy-MM-ddTHH:mm", System.Globalization.CultureInfo.InvariantCulture)
            : string.Empty;

    // TRIP-TIMELINE-01: the budget-minutes input value, or empty when unset.
    private string BudgetValue() =>
        Vm.TimeBudgetMinutes is { } m
            ? m.ToString(System.Globalization.CultureInfo.CurrentCulture)
            : string.Empty;

    // Story 4.1 (FR-26, RD10): parse the entered datetime-local value and persist the
    // FULL date+time via the VM (no more DateTime.Today hard-pairing — a multi-day trip
    // anchors to a real day). Empty clears the start (⇒ relative offsets only). The
    // browser emits ISO "yyyy-MM-ddTHH:mm", so parse with InvariantCulture.
    private async Task OnStartTimeChangedAsync(ChangeEventArgs e)
    {
        var text = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(text))
        {
            await Vm.SetTripStartTimeAsync(null);
            return;
        }

        if (DateTime.TryParse(text, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var dt))
        {
            await Vm.SetTripStartTimeAsync(dt);
        }
    }

    // TRIP-TIMELINE-01: parse the entered budget minutes and persist via the VM.
    // Empty/blank clears the budget (⇒ no overrun flag). Non-numeric is ignored.
    private async Task OnBudgetChangedAsync(ChangeEventArgs e)
    {
        var text = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(text))
        {
            await Vm.SetTimeBudgetMinutesAsync(null);
            return;
        }

        if (int.TryParse(text, System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.CurrentCulture, out var minutes) && minutes >= 0)
        {
            await Vm.SetTimeBudgetMinutesAsync(minutes);
        }
    }

    // Story 1.3: the per-leg manual-minutes entry + reset now live in the
    // LegConnector component (which raises the same Vm.Set/ClearManualLegTimeAsync
    // commands); the interim ManualMinutes/OnManualMinutesChanged helpers moved
    // there with it.

    // TRIP-DWELL-01: the current dwell minutes for a row, or empty when unset.
    private static string DwellMinutes(TripStopRow row) =>
        row.DwellMinutes is { } m
            ? m.ToString(System.Globalization.CultureInfo.CurrentCulture)
            : string.Empty;

    // TRIP-DWELL-01: parse the entered minutes and persist via the VM. Empty/blank
    // clears the dwell (null). A non-numeric value is ignored (no write).
    private async Task OnDwellMinutesChangedAsync(int poiId, object? raw)
    {
        var text = raw?.ToString();
        if (string.IsNullOrWhiteSpace(text))
        {
            await Vm.SetDwellMinutesAsync(poiId, null);
            return;
        }

        if (int.TryParse(text, System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.CurrentCulture, out var minutes) && minutes >= 0)
        {
            await Vm.SetDwellMinutesAsync(poiId, minutes);
        }
    }

    // Rows are <li role="button" tabindex="0"> — map Enter/Space onto the same
    // selection the click does, so keyboard users get the list→map sync (AC3).
    private void OnRowKeyDown(KeyboardEventArgs e, int poiId)
    {
        if (e.Key is "Enter" or " ")
        {
            Vm.SelectStop(poiId, TripSelectionSource.List);
        }
    }

    // TRIP-ORDER-04: native HTML5 DnD, pure Blazor (no JS module). The bridge
    // only remembers which PoiId the drag started on and forwards the drop's
    // target slot to the VM — clamping/pinning/no-op logic lives in the service
    // (the authoritative single OrderIndex writer), never client-side.
    private int? _draggedPoiId;

    private void OnDragStart(int poiId) => _draggedPoiId = poiId;

    private void OnDragEnd() => _draggedPoiId = null;

    private async Task OnDropAsync(int targetOrderIndex)
    {
        if (_draggedPoiId is not { } poiId)
        {
            return;
        }

        _draggedPoiId = null;
        await Vm.MoveStopToAsync(poiId, targetOrderIndex);
    }

    // TRIP-STARTFINISH-04: thin bridges only — set/clear is decided by the
    // current role; all designation logic lives in the VM → service.
    private Task OnStartClickAsync(int poiId, TripStopRole role) =>
        role == TripStopRole.Start ? Vm.ClearStartAsync() : Vm.SetStartAsync(poiId);

    private Task OnFinishClickAsync(int poiId, TripStopRole role) =>
        role == TripStopRole.Finish ? Vm.ClearFinishAsync() : Vm.SetFinishAsync(poiId);

    private string BadgeAria(TripStopRole role, int number) => role switch
    {
        TripStopRole.Start => string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripStartBadgeAria, Vm.OrderedStops.Count),
        TripStopRole.Finish => string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripFinishBadgeAria, Vm.OrderedStops.Count),
        _ => string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripStopBadgeAria, number, Vm.OrderedStops.Count),
    };

    private static string StartControlAria(TripStopRole role, string name) =>
        string.Format(System.Globalization.CultureInfo.CurrentCulture,
            role == TripStopRole.Start ? UiStrings.TripUnsetStart : UiStrings.TripSetAsStart, name);

    private static string FinishControlAria(TripStopRole role, string name) =>
        string.Format(System.Globalization.CultureInfo.CurrentCulture,
            role == TripStopRole.Finish ? UiStrings.TripUnsetFinish : UiStrings.TripSetAsFinish, name);

    public void Dispose() => Vm.StateChanged -= OnVmChanged;
}
