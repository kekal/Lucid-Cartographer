@implements IDisposable
@using LucidCartographer.Services.Trip

@* Desktop Trip View stop-list panel. All leg/stop projection logic lives in TripViewModel. *@

<section class="flex flex-col h-full bg-surface-container-low border-l border-surface-container-high"
         aria-label="@UiStrings.TripStopListAria">
    @* Header row: title, stop count, total travel time, and action buttons. *@
    <header class="flex items-center justify-between gap-2 px-3 py-2 border-b border-surface-container-high flex-shrink-0">
        <div class="flex items-baseline gap-1.5 min-w-0 text-sm">
            <span class="font-semibold text-on-surface flex-shrink-0">@UiStrings.TripStopList</span>
            <span class="text-on-surface-variant" aria-hidden="true">·</span>
            @* Live region for stop count changes; visible numeral is aria-hidden. *@
            <span class="text-xs text-on-surface-variant flex-shrink-0" role="status" aria-live="polite">
                <span aria-hidden="true">@Vm.OrderedStops.Count</span>
                <span class="sr-only">@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripStopCountAria, Vm.OrderedStops.Count)</span>
            </span>
            @if (Vm.OrderedLegs.Count > 0)
            {
                @* Trip total; uncomputed legs show em-dash. *@
                <span class="text-on-surface-variant" aria-hidden="true">·</span>
                <span class="text-xs font-semibold text-on-surface flex-shrink-0"
                      aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripTotalTravelTimeAria, TravelTimeFormatting.Duration(Vm.TotalTravelTimeSeconds))">
                    @TravelTimeFormatting.Duration(Vm.TotalTravelTimeSeconds)
                </span>
            }
        </div>
        @if (Vm.OrderedLegs.Count > 0)
        {
            <div class="flex items-center gap-1.5 flex-shrink-0">
                @* Bulk travel-mode selector; enabled while sort/recompute are disabled. *@
                <BulkLegModeSelector Vm="Vm" />
                @* TSP sort; disabled while legs compute. *@
                <button type="button"
                        class="text-xs px-2 py-1 rounded border border-surface-container-high text-on-surface enabled:hover:bg-surface-container-high disabled:opacity-50"
                        aria-label="@UiStrings.TripSortTspAria"
                        title="@UiStrings.TripSortTspAria"
                        disabled="@Vm.IsAnyLegComputing"
                        @onclick="Vm.SortTravelingSalesmanAsync">
                    @UiStrings.TripSortTspLabel
                </button>
                @* Recompute travel times; disabled while legs compute. *@
                <button type="button"
                        class="text-xs px-2 py-1 rounded border border-surface-container-high text-on-surface enabled:hover:bg-surface-container-high disabled:opacity-50"
                        aria-label="@UiStrings.TripRecomputeAria"
                        title="@UiStrings.TripRecomputeAria"
                        disabled="@Vm.IsAnyLegComputing"
                        @onclick="Vm.RecomputeTravelTimesAsync">
                    @UiStrings.TripRecomputeLabel
                </button>
            </div>
        }
    </header>
    @* Live region for sort completion announcement. *@
    <span class="sr-only" role="status" aria-live="polite">@Vm.LastSortAnnouncement</span>

    @* Header inputs: start time, time limit, finish-by deadline, and over-limit flag. *@
    @if (Vm.OrderedLegs.Count > 0)
    {
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 px-3 py-1.5 border-b border-surface-container-high flex-shrink-0 text-xs min-w-0">
            <label class="flex items-center gap-1 text-on-surface-variant min-w-0">
                <span class="flex-shrink-0">@UiStrings.TripStartTimeLabel</span>
                <input type="datetime-local"
                       class="min-w-0 w-auto text-xs px-1 py-0.5 rounded border border-surface-container-high bg-surface-container-low text-on-surface"
                       aria-label="@UiStrings.TripStartTimeAria"
                       value="@StartTimeValue()"
                       @onchange="OnStartTimeChangedAsync" />
            </label>
            @* Time limit as HH:MM duration input; canonical store is TimeBudgetMinutes. *@
            <label class="flex items-center gap-1 text-on-surface-variant min-w-0">
                <span class="flex-shrink-0">@UiStrings.TripTimeLimitLabel</span>
                <DurationInput Value="Vm.TimeBudgetMinutes"
                               ValueChanged="OnBudgetChangedAsync"
                               Max="TripViewModel.MaxBudgetMinutes"
                               AriaLabel="@UiStrings.TripTimeLimitAria"
                               Placeholder="@UiStrings.TripTimeLimitPlaceholder" />
            </label>
            @* Finish-by deadline; derived from start + budget. Disabled without a start. *@
            <label class="flex items-center gap-1 text-on-surface-variant min-w-0">
                <span class="flex-shrink-0">@UiStrings.TripFinishByLabel</span>
                <input type="datetime-local"
                       @key="_finishByRev"
                       class="min-w-0 w-auto text-xs px-1 py-0.5 rounded border border-surface-container-high bg-surface-container-low text-on-surface disabled:opacity-50"
                       aria-label="@UiStrings.TripFinishByAria"
                       disabled="@(Vm.TripStartTime is null)"
                       value="@FinishByValue()"
                       @onchange="OnFinishByChangedAsync" />
            </label>
            @if (Vm.TripStartTime is null)
            {
                <span class="text-on-surface-variant opacity-70">@UiStrings.TripFinishByNeedsStartHint</span>
            }
            @if (Vm.Timeline.IsOverBudget)
            {
                @* Over-limit indicator; soft amber tone. *@
                <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-amber-600 bg-surface-container"
                      role="status" aria-label="@UiStrings.TripOverLimitAria">
                    <span class="material-symbols-outlined" style="font-size:14px" aria-hidden="true">schedule</span>
                    @UiStrings.TripOverLimitLabel
                </span>
            }
        </div>
    }

    @* Live region for leg computing state announcement. *@
    <span class="sr-only" role="status" aria-live="polite">@(Vm.IsAnyLegComputing ? UiStrings.TripLegComputingAnnouncement : null)</span>

    @* Note when legs fall back to straight-line estimate (routing engine unreachable). *@
    @if (Vm.IsShowingApproximateEstimates)
    {
        <div class="flex items-start gap-1.5 px-3 py-1.5 border-b border-surface-container-high flex-shrink-0 text-xs text-on-surface-variant bg-surface-container"
             role="status" aria-live="polite">
            <span class="material-symbols-outlined flex-shrink-0" style="font-size:16px" aria-hidden="true">info</span>
            <span>@UiStrings.TripApproximateEstimatesNote</span>
        </div>
    }
    @* Measured-provider recommendation on default Mock-provider deployment; guidance only. *@
    @if (Vm.RecommendsMeasuredProvider && !Vm.IsShowingApproximateEstimates)
    {
        <div class="flex items-start gap-1.5 px-3 py-1.5 border-b border-surface-container-high flex-shrink-0 text-xs text-on-surface-variant bg-surface-container">
            <span class="material-symbols-outlined flex-shrink-0" style="font-size:16px" aria-hidden="true">info</span>
            <span>
                @UiStrings.TripMockEstimateNote
                <a href="@UiStrings.TripMockEstimateValhallaHref" target="_blank" rel="noopener"
                   class="text-primary hover:underline">@UiStrings.TripMockEstimateValhallaLink</a>
            </span>
        </div>
    }

    @* Live region for selection announcement. *@
    <span class="sr-only" role="status" aria-live="polite">@Vm.SelectionAnnouncement</span>

    @* Live region for reorder announcement. *@
    <span class="sr-only" role="status" aria-live="polite">@Vm.LastReorderAnnouncement</span>

    @* Live region for Start/Finish designation changes. *@
    <span class="sr-only" role="status" aria-live="polite">@Vm.StartFinishAnnouncement</span>

    @if (Vm.StopRows.Count == 0)
    {
        <div class="px-3 py-4 text-sm text-on-surface-variant">@UiStrings.TripStopListEmpty</div>
    }
    else
    {
        @* Trip-scoped stop list with shared CSS-grid column template for alignment. *@
        <ul class="flex-1 overflow-y-auto trip-stop-list" aria-label="@UiStrings.TripStopListAria">
            @for (var index = 0; index < Vm.StopRows.Count; index++)
            {
                var row = Vm.StopRows[index];
                @if (!row.IsPlaceable)
                {
                    @* Not placeable row; in list but not selectable, uses same grid template. *@
                    <li @key="row.PoiId" data-poi-id="@row.PoiId"
                        aria-label="@UiStrings.TripStopNotPlaceableAria"
                        title="@UiStrings.TripStopNotPlaceableDetail"
                        style="display:grid;grid-template-columns:@GridTemplate;align-items:center"
                        class="gap-2 px-2 py-2 border-b border-surface-container opacity-60">
                        @* Reorder gutter (empty for unplaceable rows). *@
                        <span aria-hidden="true"></span>
                        @* Not-placeable marker in badge slot. *@
                        <span class="inline-flex items-center justify-center w-5 h-5 rounded-full border border-on-surface-variant text-on-surface-variant text-xs"
                              aria-hidden="true">—</span>
                        @* Name, address, and enrichment icon. *@
                        <div class="min-w-0">
                            <div class="flex items-center gap-1.5 min-w-0">
                                @{ var (uIcon, uIconClass, uIconTitle) = EnrichmentIcon(row); }
                                <span class="material-symbols-outlined text-base @uIconClass flex-shrink-0" aria-hidden="true" title="@uIconTitle">@uIcon</span>
                                <span class="text-sm text-on-surface-variant break-words" title="@row.Name">@row.Name</span>
                            </div>
                            @if (!string.IsNullOrEmpty(row.Address))
                            {
                                <div class="text-xs text-on-surface-variant break-words">@row.Address</div>
                            }
                        </div>
                        @* Dwell input (unplaceable stops have no travel time but carry dwell). *@
                        <DurationInput Value="row.DwellMinutes"
                                       ValueChanged="m => OnDwellChangedAsync(row.PoiId, m)"
                                       Max="TripViewModel.MaxDwellMinutes"
                                       AriaLabel="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripDwellAria, row.Name)"
                                       ContainerClass="w-24" />
                        @* Arrival slot (unplaceable rows have no routed arrival). *@
                        <span class="text-xs text-on-surface-variant">@UiStrings.TripStopNotPlaceable</span>
                        @* Start/Finish slot (empty for unplaceable rows). *@
                        <span aria-hidden="true"></span>
                        @* Actions slot (empty for unplaceable rows). *@
                        <span aria-hidden="true"></span>
                    </li>
                }
                else
                {
                    var stop = Vm.OrderedStops.First(s => s.PoiId == row.PoiId);
                    var selected = Vm.SelectedStopPoiId == row.PoiId;
                    var number = row.DisplayOrder!.Value;
                    var role = Vm.StopRole(row.PoiId);
                    var arrival = ArrivalFor(row.PoiId);
                    @* Selectable row; selected rows get primary ring and aria-current. *@
                    <li @key="row.PoiId" data-poi-id="@row.PoiId"
                        role="button" tabindex="0"
                        aria-current="@(selected ? "true" : null)"
                        aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripStopRowAria, number, Vm.OrderedStops.Count, row.Name)"
                        draggable="true"
                        @onclick="() => Vm.SelectStop(row.PoiId, TripSelectionSource.List)"
                        @onkeydown="e => OnRowKeyDown(e, row.PoiId)"
                        @ondragstart="() => OnDragStart(row.PoiId)"
                        @ondragover:preventDefault
                        @ondrop="() => OnDropAsync(stop.OrderIndex)"
                        @ondrop:preventDefault
                        @ondragend="OnDragEnd"
                        style="display:grid;grid-template-columns:@GridTemplate;align-items:center"
                        class="gap-2 px-2 py-2 border-b border-surface-container cursor-pointer @(selected ? "bg-primary/10 ring-1 ring-inset ring-primary" : "hover:bg-surface-container")">
                        @* Reorder gutter: drag handle and ▲▼ move buttons. *@
                        <span class="flex items-center gap-0.5">
                            <span class="cursor-grab text-on-surface-variant select-none"
                                  aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripDragHandle, row.Name)"
                                  title="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripDragHandle, row.Name)">
                                <span aria-hidden="true">⠿</span>
                            </span>
                            <span class="flex flex-col">
                                <button type="button"
                                        class="inline-flex items-center justify-center w-5 h-5 rounded text-on-surface-variant enabled:hover:bg-surface-container-high disabled:opacity-40"
                                        aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripMoveStopUp, row.Name)"
                                        title="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripMoveStopUp, row.Name)"
                                        disabled="@(!Vm.CanMoveUp(stop))"
                                        @onclick="() => Vm.MoveStopUpAsync(row.PoiId)"
                                        @onclick:stopPropagation
                                        @onkeydown:stopPropagation>
                                    <span aria-hidden="true">▲</span>
                                </button>
                                <button type="button"
                                        class="inline-flex items-center justify-center w-5 h-5 rounded text-on-surface-variant enabled:hover:bg-surface-container-high disabled:opacity-40"
                                        aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripMoveStopDown, row.Name)"
                                        title="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripMoveStopDown, row.Name)"
                                        disabled="@(!Vm.CanMoveDown(stop))"
                                        @onclick="() => Vm.MoveStopDownAsync(row.PoiId)"
                                        @onclick:stopPropagation
                                        @onkeydown:stopPropagation>
                                    <span aria-hidden="true">▼</span>
                                </button>
                            </span>
                        </span>
                        @* Stop # badge with Start/Finish ring and glyph. *@
                        <span class="flex items-center gap-1">
                            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-primary text-on-primary text-xs font-bold flex-shrink-0@(role == TripStopRole.Start ? " ring-2 ring-primary ring-offset-1" : role == TripStopRole.Finish ? " ring-2 ring-on-surface-variant ring-offset-1" : "")"
                                  aria-label="@BadgeAria(role, number)">
                                <span aria-hidden="true">@number</span>
                            </span>
                            @if (role == TripStopRole.Start)
                            {
                                <span class="material-symbols-outlined text-primary flex-shrink-0" style="font-size:16px" aria-hidden="true">trip_origin</span>
                            }
                            else if (role == TripStopRole.Finish)
                            {
                                <span class="material-symbols-outlined text-on-surface-variant flex-shrink-0" style="font-size:16px" aria-hidden="true">sports_score</span>
                            }
                        </span>
                        @* Name, address sub-line, and enrichment icon. *@
                        <div class="min-w-0">
                            <div class="flex items-center gap-1.5 min-w-0">
                                @{ var (icon, iconClass, iconTitle) = EnrichmentIcon(row); }
                                <span class="material-symbols-outlined text-base @iconClass flex-shrink-0" aria-hidden="true" title="@iconTitle">@icon</span>
                                <span class="text-sm font-medium text-on-surface break-words" title="@row.Name">@row.Name</span>
                            </div>
                            @if (!string.IsNullOrEmpty(row.Address))
                            {
                                <div class="text-xs text-on-surface-variant break-words">@row.Address</div>
                            }
                        </div>
                        @* Dwell input. *@
                        <DurationInput Value="row.DwellMinutes"
                                       ValueChanged="m => OnDwellChangedAsync(row.PoiId, m)"
                                       Max="TripViewModel.MaxDwellMinutes"
                                       AriaLabel="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripDwellAria, row.Name)"
                                       ContainerClass="w-24" />
                        @* Arrival time (relative offset). *@
                        <span class="text-xs text-on-surface-variant text-right">
                            @if (arrival is not null)
                            {
                                @* Compact form in visible text; full text in title and aria-label. *@
                                <span title="@ArrivalText(arrival)"
                                      aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripTimelineArrivalAria, ArrivalText(arrival))">
                                    @ArrivalCompactText(arrival)
                                </span>
                            }
                            else
                            {
                                <span aria-label="@UiStrings.TripLegNoTravelTimeAria">@UiStrings.TripLegTimeUnknown</span>
                            }
                        </span>
                        @* Start/Finish controls. *@
                        <span class="flex items-center gap-0.5">
                            <button type="button"
                                    class="inline-flex items-center justify-center w-6 h-6 rounded enabled:hover:bg-surface-container-high disabled:opacity-40 @(role == TripStopRole.Start ? "text-primary" : "text-on-surface-variant")"
                                    aria-label="@StartControlAria(role, row.Name)"
                                    title="@StartControlAria(role, row.Name)"
                                    aria-pressed="@(role == TripStopRole.Start ? "true" : "false")"
                                    disabled="@(!Vm.CanSetStart(row.PoiId))"
                                    @onclick="() => OnStartClickAsync(row.PoiId, role)"
                                    @onclick:stopPropagation
                                    @onkeydown:stopPropagation>
                                <span class="material-symbols-outlined" style="font-size:18px" aria-hidden="true">trip_origin</span>
                            </button>
                            <button type="button"
                                    class="inline-flex items-center justify-center w-6 h-6 rounded enabled:hover:bg-surface-container-high disabled:opacity-40 @(role == TripStopRole.Finish ? "text-primary" : "text-on-surface-variant")"
                                    aria-label="@FinishControlAria(role, row.Name)"
                                    title="@FinishControlAria(role, row.Name)"
                                    aria-pressed="@(role == TripStopRole.Finish ? "true" : "false")"
                                    disabled="@(!Vm.CanSetFinish(row.PoiId))"
                                    @onclick="() => OnFinishClickAsync(row.PoiId, role)"
                                    @onclick:stopPropagation
                                    @onkeydown:stopPropagation>
                                <span class="material-symbols-outlined" style="font-size:18px" aria-hidden="true">sports_score</span>
                            </button>
                        </span>
                        @* Actions: Focus on map and Open in Google Maps. *@
                        <span class="flex items-center justify-end gap-0.5">
                            <button type="button"
                                    class="inline-flex items-center justify-center w-7 h-7 rounded text-on-surface-variant hover:text-primary hover:bg-surface-container-high"
                                    aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripFocusOnMapAria, row.Name)"
                                    title="@UiStrings.TripFocusOnMap"
                                    @onclick="() => OnFocusClickAsync(row.PoiId)"
                                    @onclick:stopPropagation
                                    @onkeydown:stopPropagation>
                                <span class="material-symbols-outlined text-base" aria-hidden="true">my_location</span>
                            </button>
                            <a href="@row.GoogleMapsUrl" target="_blank" rel="noopener"
                               class="inline-flex items-center justify-center w-7 h-7 rounded text-primary hover:bg-surface-container-high"
                               aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripOpenInGoogleMapsAria, row.Name)"
                               title="@UiStrings.TripOpenInGoogleMaps"
                               @onclick:stopPropagation>
                                <span class="material-symbols-outlined text-base" aria-hidden="true">open_in_new</span>
                            </a>
                        </span>
                    </li>
                }

                @* Inter-row leg connector; renders travel time, distance, and manual controls. *@
                var connectorLeg = LegFrom(row.PoiId);
                @if (connectorLeg is not null)
                {
                    <li>
                        <LegConnector Leg="connectorLeg" Vm="Vm" />
                    </li>
                }
            }
        </ul>
    }

    @* Finish/return readout at the end of the list. *@
    @if (Vm.Timeline.FinishOrReturn is { } finish)
    {
        <div class="flex items-center justify-between px-3 py-1.5 border-t border-surface-container-high flex-shrink-0 text-xs">
            <span class="text-on-surface-variant">@(Vm.IsRoundtrip ? UiStrings.TripTimelineFinishLabel : UiStrings.TripTimelineFinishOpenLabel)</span>
            <span class="font-semibold text-on-surface whitespace-nowrap"
                  aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripTimelineFinishAria, ArrivalText(finish))">
                @ArrivalText(finish)
            </span>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public TripViewModel Vm { get; set; } = null!;

    // Optional callback for map-focus parity; falls back to stop selection if unwired.
    [Parameter] public EventCallback<int> OnFocusClicked { get; set; }

    // CSS-grid column template for row alignment; name column flexes to fit full POI name.
    private const string GridTemplate =
        "auto auto minmax(0,1fr) auto auto auto auto";

    protected override void OnInitialized() => Vm.StateChanged += OnVmChanged;

    private void OnVmChanged() => InvokeAsync(StateHasChanged);

    // Leg departing a given stop (to next stop, or closing leg for roundtrips).
    private TripLeg? LegFrom(int poiId) =>
        Vm.OrderedLegs.FirstOrDefault(l => l.FromPoiId == poiId);

    // Enrichment-state icon for the Name column (mirrors PoiTable logic).
    private static (string Icon, string Class, string Title) EnrichmentIcon(TripStopRow row) => row switch
    {
        { EnrichmentNeedsManualUrl: true } => ("error", "text-red-500", UiStrings.TripEnrichmentFailed),
        { IsEnriched: true } => ("location_on", "text-on-surface-variant", UiStrings.TripEnrichmentEnriched),
        _ => ("hourglass_empty", "text-amber-500", UiStrings.TripEnrichmentWaiting),
    };

    // Map-focus callback; falls back to stop selection if not wired.
    private async Task OnFocusClickAsync(int poiId)
    {
        if (OnFocusClicked.HasDelegate)
        {
            await OnFocusClicked.InvokeAsync(poiId);
        }
        else
        {
            Vm.SelectStop(poiId, TripSelectionSource.List);
        }
    }

    // Per-stop arrival, or null if the row is unplaceable (no routed arrival).
    private ItineraryArrival? ArrivalFor(int poiId) =>
        Vm.Timeline.Stops.FirstOrDefault(a => a.PoiId == poiId);

    // UI display string for an arrival (offset, wall-clock if start is set, qualified, or "—" if unknown).
    private string ArrivalText(ItineraryArrival a) =>
        TravelTimeFormatting.Arrival(a.OffsetSeconds, a.ArrivalWallClock, a.QualifyingFidelity, a.IsUnknown, Vm.TripStartTime);

    // Compact arrival text (no qualifier word); full text in title and aria-label.
    private string ArrivalCompactText(ItineraryArrival a) =>
        TravelTimeFormatting.ArrivalCompact(a.OffsetSeconds, a.ArrivalWallClock, a.QualifyingFidelity, a.IsUnknown, Vm.TripStartTime);

    // Value for datetime-local input (ISO format, invariant regardless of locale); empty if no start.
    private string StartTimeValue() =>
        Vm.TripStartTime is { } t
            ? t.ToString("yyyy-MM-ddTHH:mm", System.Globalization.CultureInfo.InvariantCulture)
            : string.Empty;

    // Finish-by deadline derived from start + budget; empty if either is unset.
    private string FinishByValue() =>
        Vm.TripStartTime is { } start && Vm.TimeBudgetMinutes is { } m
            ? start.AddMinutes(m).ToString("yyyy-MM-ddTHH:mm", System.Globalization.CultureInfo.InvariantCulture)
            : string.Empty;

    // Parse datetime-local input and persist to VM (or clear if empty); browser emits ISO format.
    private async Task OnStartTimeChangedAsync(ChangeEventArgs e)
    {
        var text = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(text))
        {
            await Vm.SetTripStartTimeAsync(null);
            return;
        }

        if (DateTime.TryParse(text, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var dt))
        {
            await Vm.SetTripStartTimeAsync(dt);
        }
    }

    // Pass time-limit budget (in minutes) to VM; HH:MM conversion is in DurationInput component.
    private Task OnBudgetChangedAsync(int? minutes) => Vm.SetTimeBudgetMinutesAsync(minutes);

    // Re-key for finish-by input; bumped on each edit to snap the field back to derived value.
    private int _finishByRev;

    // Back-compute budget from finish-by deadline; validates 0 ≤ minutes ≤ MaxBudgetMinutes.
    private async Task OnFinishByChangedAsync(ChangeEventArgs e)
    {
        if (Vm.TripStartTime is { } start)
        {
            var text = e.Value?.ToString();
            if (string.IsNullOrWhiteSpace(text))
            {
                await Vm.SetTimeBudgetMinutesAsync(null);
            }
            else if (DateTime.TryParse(text, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var deadline))
            {
                var minutes = (int)Math.Round((deadline - start).TotalMinutes);
                if (minutes >= 0 && minutes <= TripViewModel.MaxBudgetMinutes)
                {
                    await Vm.SetTimeBudgetMinutesAsync(minutes);
                }
            }
        }

        _finishByRev++;
    }

    // Per-leg manual-minutes entry and reset now live in LegConnector component.

    // Pass dwell duration (in minutes) to VM; HH:MM conversion is in DurationInput component.
    private Task OnDwellChangedAsync(int poiId, int? minutes) => Vm.SetDwellMinutesAsync(poiId, minutes);

    // Map Enter/Space keys to stop selection (list-to-map sync).
    private void OnRowKeyDown(KeyboardEventArgs e, int poiId)
    {
        if (e.Key is "Enter" or " ")
        {
            Vm.SelectStop(poiId, TripSelectionSource.List);
        }
    }

    // Native HTML5 drag-drop (pure Blazor, no JS module); VM handles clamping/pinning logic.
    private int? _draggedPoiId;

    private void OnDragStart(int poiId) => _draggedPoiId = poiId;

    private void OnDragEnd() => _draggedPoiId = null;

    private async Task OnDropAsync(int targetOrderIndex)
    {
        if (_draggedPoiId is not { } poiId)
        {
            return;
        }

        _draggedPoiId = null;
        await Vm.MoveStopToAsync(poiId, targetOrderIndex);
    }

    // Start/Finish designation logic lives in VM; role determines set/clear.
    private Task OnStartClickAsync(int poiId, TripStopRole role) =>
        role == TripStopRole.Start ? Vm.ClearStartAsync() : Vm.SetStartAsync(poiId);

    private Task OnFinishClickAsync(int poiId, TripStopRole role) =>
        role == TripStopRole.Finish ? Vm.ClearFinishAsync() : Vm.SetFinishAsync(poiId);

    private string BadgeAria(TripStopRole role, int number) => role switch
    {
        TripStopRole.Start => string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripStartBadgeAria, Vm.OrderedStops.Count),
        TripStopRole.Finish => string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripFinishBadgeAria, Vm.OrderedStops.Count),
        _ => string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripStopBadgeAria, number, Vm.OrderedStops.Count),
    };

    private static string StartControlAria(TripStopRole role, string name) =>
        string.Format(System.Globalization.CultureInfo.CurrentCulture,
            role == TripStopRole.Start ? UiStrings.TripUnsetStart : UiStrings.TripSetAsStart, name);

    private static string FinishControlAria(TripStopRole role, string name) =>
        string.Format(System.Globalization.CultureInfo.CurrentCulture,
            role == TripStopRole.Finish ? UiStrings.TripUnsetFinish : UiStrings.TripSetAsFinish, name);

    public void Dispose() => Vm.StateChanged -= OnVmChanged;
}
