@implements IDisposable

@* Desktop Trip View stop-list panel (Story 1.3, AC2). Markup + a ~12-line VM
   bridge only — all leg/stop projection logic lives in TripViewModel. Shown
   beside the map when Trip View is on. Rows echo PoiTable's rhythm but are
   trip-scoped: [drag-handle gutter (Story 1.5)] · [order badge] · [POI name] ·
   [dwell-time placeholder] · [timeline-value placeholder]. The dwell + timeline
   values are inert "—" placeholders here; the real values arrive in Epic 2. *@

<section class="flex flex-col h-full bg-surface-container-low border-l border-surface-container-high"
         aria-label="@UiStrings.TripStopListAria">
    <header class="flex items-center justify-between px-3 py-2 border-b border-surface-container-high flex-shrink-0">
        <span class="text-sm font-semibold text-on-surface">@UiStrings.TripStopList</span>
        @* aria-live announces the stop count as it changes (seed / reorder /
           membership). The live region's announced string is its text content —
           the visible numeral is aria-hidden and an sr-only child carries the
           full localized phrase (e.g. "3 stop trip"), rather than an aria-label
           that competes with the text node on a live region. *@
        <span class="text-xs text-on-surface-variant" role="status" aria-live="polite">
            <span aria-hidden="true">@Vm.OrderedStops.Count</span>
            <span class="sr-only">@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripStopCountAria, Vm.OrderedStops.Count)</span>
        </span>
    </header>

    @* TRIP-SELECT-05: announces the selected stop (list→map or map→list). *@
    <span class="sr-only" role="status" aria-live="polite">@Vm.SelectionAnnouncement</span>

    @if (Vm.StopRows.Count == 0)
    {
        <div class="px-3 py-4 text-sm text-on-surface-variant">@UiStrings.TripStopListEmpty</div>
    }
    else
    {
        @* `trip-stop-list` scopes the JS scroll-into-view helper (TRIP-SELECT-05). *@
        <ul class="flex-1 overflow-y-auto trip-stop-list" aria-label="@UiStrings.TripStopListAria">
            @foreach (var row in Vm.StopRows)
            {
                @if (!row.IsPlaceable)
                {
                    @* [TRIP-PLACE-04] "Not placeable" row (UX-DR10/UX-DR11): kept in
                       the list — never dropped — but de-emphasized, NOT selectable
                       (no marker to pan to), and with the not-placeable marker
                       replacing the routed order badge so the placeable numbering
                       reads contiguous with no visible gap. The aria-label tells a
                       screen reader the honest story; the title carries the full
                       provenance sentence. *@
                    <li @key="row.PoiId" data-poi-id="@row.PoiId"
                        aria-label="@UiStrings.TripStopNotPlaceableAria"
                        title="@UiStrings.TripStopNotPlaceableDetail"
                        class="flex items-center gap-2 px-2 py-2 border-b border-surface-container opacity-60">
                        <span class="w-4 flex-shrink-0" aria-hidden="true"></span>
                        @* Not-placeable marker in the badge slot — outlined, muted,
                           no number (explicit empty markers are first-class). *@
                        <span class="inline-flex items-center justify-center w-5 h-5 rounded-full border border-on-surface-variant text-on-surface-variant text-xs flex-shrink-0"
                              aria-hidden="true">—</span>
                        <span class="flex-1 min-w-0 truncate text-sm text-on-surface-variant" title="@row.Name">@row.Name</span>
                        <span class="text-xs text-on-surface-variant flex-shrink-0">@UiStrings.TripStopNotPlaceable</span>
                    </li>
                }
                else
                {
                    var selected = Vm.SelectedStopPoiId == row.PoiId;
                    var number = row.DisplayOrder!.Value;
                    @* TRIP-SELECT-05: selectable row — click / Enter / Space select the
                       stop (list→map). data-poi-id lets the scroll helper locate it on
                       the map→list direction. Selected rows get a primary-token ring +
                       tint and expose aria-current to AT (AC3). *@
                    <li @key="row.PoiId" data-poi-id="@row.PoiId"
                        role="button" tabindex="0"
                        aria-current="@(selected ? "true" : null)"
                        aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripStopRowAria, number, Vm.OrderedStops.Count, row.Name)"
                        @onclick="() => Vm.SelectStop(row.PoiId, TripSelectionSource.List)"
                        @onkeydown="e => OnRowKeyDown(e, row.PoiId)"
                        class="flex items-center gap-2 px-2 py-2 border-b border-surface-container cursor-pointer @(selected ? "bg-primary/10 ring-1 ring-inset ring-primary" : "hover:bg-surface-container")">
                        @* Leading gutter reserved for the Story-1.5 drag handle / move
                           controls — render nothing here now, just hold the space. *@
                        <span class="w-4 flex-shrink-0" aria-hidden="true"></span>
                        @* Order badge: primary-filled numbered circle (UX-DR2). The
                           descriptive "Stop X of Y" label conveys the position; the
                           bare numeral is hidden so it isn't read twice. The number is
                           the presented routed order over the placeable subset —
                           contiguous 1..M ([TRIP-ORDER-UNPLACE-01]). *@
                        <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-primary text-on-primary text-xs font-bold flex-shrink-0"
                              aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, UiStrings.TripStopBadgeAria, number, Vm.OrderedStops.Count)">
                            <span aria-hidden="true">@number</span>
                        </span>
                        <span class="flex-1 min-w-0 truncate text-sm text-on-surface" title="@row.Name">@row.Name</span>
                        @* Inert placeholders (Epic 2 computes the real values). *@
                        <span class="text-xs text-on-surface-variant flex-shrink-0"
                              aria-label="@UiStrings.TripDwellAria">@UiStrings.TripDwellPlaceholder</span>
                        <span class="text-xs text-on-surface-variant flex-shrink-0 w-6 text-right"
                              aria-label="@UiStrings.TripTimelineAria">@UiStrings.TripTimelinePlaceholder</span>
                    </li>
                }
            }
        </ul>
    }
</section>

@code {
    [Parameter, EditorRequired] public TripViewModel Vm { get; set; } = null!;

    protected override void OnInitialized() => Vm.StateChanged += OnVmChanged;

    private void OnVmChanged() => InvokeAsync(StateHasChanged);

    // Rows are <li role="button" tabindex="0"> — map Enter/Space onto the same
    // selection the click does, so keyboard users get the list→map sync (AC3).
    private void OnRowKeyDown(KeyboardEventArgs e, int poiId)
    {
        if (e.Key is "Enter" or " ")
        {
            Vm.SelectStop(poiId, TripSelectionSource.List);
        }
    }

    public void Dispose() => Vm.StateChanged -= OnVmChanged;
}
