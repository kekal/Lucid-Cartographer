@using LucidCartographer.Data.Entities

@* Small provenance pill qualifying a leg's travel time. Placeholder and null fidelities
   are never shown; the time slot renders an em-dash instead. *@

@{
    var label = Label(Fidelity);
}
@if (label is not null)
{
    @* Tooltip is used for both title and aria-label (parity). *@
    var tooltip = Tooltip(Fidelity);
    <span class="@PillClass(Fidelity)"
          aria-label="@tooltip"
          title="@tooltip">
        @label
    </span>
}

@code {
    /// <summary>The leg's cached fidelity (one of <see cref="Fidelity"/>), or null when uncomputed.</summary>
    [Parameter, EditorRequired] public string? Fidelity { get; set; }

    // Placeholder and null never render a badge (time slot shows "—" instead).
    private static string? Label(string? fidelity) => fidelity switch
    {
        Data.Entities.Fidelity.Measured => UiStrings.TripFidelityMeasured,
        Data.Entities.Fidelity.Estimated => UiStrings.TripFidelityEstimated,
        Data.Entities.Fidelity.Manual => UiStrings.TripFidelityManual,
        _ => null,
    };

    // Only Measured, Estimated, and Manual have tooltips (Placeholder/null never render).
    private static string? Tooltip(string? fidelity) => fidelity switch
    {
        Data.Entities.Fidelity.Measured => UiStrings.TripFidelityMeasuredTooltip,
        Data.Entities.Fidelity.Estimated => UiStrings.TripFidelityEstimatedTooltip,
        Data.Entities.Fidelity.Manual => UiStrings.TripFidelityManualTooltip,
        _ => null,
    };

    private static string PillClass(string? fidelity)
    {
        var tone = fidelity switch
        {
            Data.Entities.Fidelity.Measured => "border-secondary text-secondary",
            Data.Entities.Fidelity.Manual => "border-primary text-primary",
            _ => "border-on-surface-variant text-on-surface-variant",
        };
        return $"inline-flex items-center px-1.5 py-0.5 rounded border text-xs font-medium leading-none flex-shrink-0 {tone}";
    }
}
