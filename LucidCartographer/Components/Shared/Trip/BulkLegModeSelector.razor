@using LucidCartographer.Data.Entities
@using LucidCartographer.Services.Trip

@* TRIP-BULKMODE-01: header control that assigns ONE travel mode to ALL legs of the
   active trip in a single action. A PRESENTATIONAL component (NFR1) — it raises only
   the VM command Vm.SetAllLegsModeAsync and never touches services/DB or mutates its
   own persisted state. A small button ("Set mode for all…") opens a popover holding an
   overwrite checkbox (default OFF = fill only the undefined Any/Air legs) above the four
   mode choices (Walk / Drive / Cycle / Any-Air). Choosing a mode applies it and closes.
   It is the REMEDY for uncomputed / Any-Air legs, not a consumer of settled times — so it
   deliberately does NOT gate on IsAnyLegComputing (that would disable it exactly when an
   all-Any/Air trip needs it). Only transiently disabled while its own bulk request is in
   flight (anti-double-submit). stopPropagation so the header never triggers a row
   interaction. All copy via UiStrings. *@

<div class="relative inline-flex" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
    <button type="button"
            class="inline-flex items-center gap-1 text-xs px-2 py-1 rounded border border-surface-container-high text-on-surface enabled:hover:bg-surface-container-high disabled:opacity-50"
            aria-haspopup="true"
            aria-expanded="@(_open ? "true" : "false")"
            aria-label="@UiStrings.TripBulkModeAria"
            title="@UiStrings.TripBulkModeAria"
            disabled="@_busy"
            @onclick="Toggle"
            @onclick:stopPropagation="true">
        <span class="material-symbols-outlined" style="font-size:14px" aria-hidden="true">edit_road</span>
        <span>@UiStrings.TripBulkModeLabel</span>
    </button>

    @if (_open)
    {
        @* Popover: overwrite toggle (subordinate, secondary tone) above a separator and
           the four mode items. role=menu; each mode is a plain menuitem (this is an action,
           not a persisted radio state — the selector itself holds no current value). *@
        <div role="menu"
             aria-label="@UiStrings.TripBulkModeMenuAria"
             class="absolute right-0 top-full z-10 mt-1 min-w-[12rem] rounded-md border border-surface-container-high bg-surface-container-low shadow-md py-1"
             @onclick:stopPropagation="true"
             @onkeydown:stopPropagation="true">
            <label class="flex items-center gap-2 px-2 py-1 text-xs text-on-surface-variant cursor-pointer hover:bg-surface-container">
                <input type="checkbox" @bind="_overwrite" aria-label="@UiStrings.TripBulkModeOverwriteAria" />
                <span>@UiStrings.TripBulkModeOverwriteLabel</span>
            </label>
            <div class="my-1 border-t border-surface-container-high" role="separator"></div>
            @foreach (var (mode, label) in Modes)
            {
                <button type="button"
                        role="menuitem"
                        aria-label="@label"
                        class="flex w-full items-center gap-2 px-2 py-1 text-xs text-left text-on-surface hover:bg-surface-container"
                        @onclick="() => ChooseAsync(mode)"
                        @onclick:stopPropagation="true"
                        @onkeydown:stopPropagation="true">
                    <span class="material-symbols-outlined" style="font-size:16px" aria-hidden="true">@GlyphFor(mode)</span>
                    <span class="flex-1">@label</span>
                </button>
            }
        </div>
    }
</div>

@code {
    /// <summary>
    /// The owning Trip view-model. The selector raises the single VM command
    /// <see cref="TripViewModel.SetAllLegsModeAsync"/> only — it never touches services/DB
    /// and never mutates its own state (NFR1).
    /// </summary>
    [Parameter, EditorRequired] public TripViewModel Vm { get; set; } = null!;

    private bool _open;
    private bool _overwrite;
    private bool _busy;

    // The four selectable modes with their UiStrings labels (Any-Air last; the
    // "undefined / manual-only" choice). Mirrors LegModePill's label conventions.
    private static readonly (string Mode, string Label)[] Modes =
    [
        (TravelMode.Walk, UiStrings.TripTravelModeWalk),
        (TravelMode.Drive, UiStrings.TripTravelModeDrive),
        (TravelMode.Cycle, UiStrings.TripTravelModeCycle),
        (TravelMode.AnyAir, UiStrings.TripTravelModeAnyAir),
    ];

    private void Toggle()
    {
        _open = !_open;
        if (_open)
        {
            // Re-assert the non-destructive default on every open so a one-off overwrite
            // never silently carries into the next assignment (the checkbox is not sticky).
            _overwrite = false;
        }
    }

    private async Task ChooseAsync(string mode)
    {
        if (_busy)
        {
            return;
        }
        _busy = true;
        _open = false;
        try
        {
            await Vm.SetAllLegsModeAsync(mode, _overwrite);
        }
        finally
        {
            _busy = false;
        }
    }

    // Mode glyphs match LegModePill: undefined/Any-Air uses a NEUTRAL help glyph
    // (never an error icon). Material Symbols, per the project's icon convention.
    private static string GlyphFor(string mode) => mode switch
    {
        TravelMode.Walk => "directions_walk",
        TravelMode.Drive => "directions_car",
        TravelMode.Cycle => "directions_bike",
        _ => "help_outline",
    };
}
