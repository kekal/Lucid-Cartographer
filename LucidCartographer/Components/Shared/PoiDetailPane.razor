@using LucidCartographer.Data.Entities

@if (Poi is null)
{
    return;
}

<div class="flex flex-col h-full bg-white">
    @* Header *@
    <div class="flex items-center justify-between p-4 flex-shrink-0">
        <h3 class="font-bold font-headline">@UiStrings.LocationDetails</h3>
        <button class="p-1 rounded hover:bg-surface-container-low transition-colors"
                aria-label="@UiStrings.CloseDetailPane"
                @onclick="() => OnClose.InvokeAsync()">
            <span class="material-symbols-outlined" aria-hidden="true">close</span>
        </button>
    </div>

    @* Content *@
    <div class="flex-1 overflow-y-auto px-4 pb-4">
        @* Image *@
        @if (!string.IsNullOrEmpty(Poi.ImageUrl))
        {
            <div class="mb-3 rounded-lg overflow-hidden">
                @* Served from our own endpoint against PoiImages.Data — Google
                   blocks hotlinking of googleusercontent URLs cross-origin and
                   the signed tokens expire within minutes, so we persist the
                   bytes at scrape time. ImageUrl (the original Google source)
                   is the presence flag; the actual render goes through
                   /api/poi-image/{id}. *@
                <img src="/api/poi-image/@Poi.Id" alt="@Poi.Name"
                     class="w-full h-40 object-cover" loading="lazy" />
            </div>
        }

        @* Name (with inline edit + "use the Google Maps name" actions) & Address *@
        <div class="flex items-start gap-1 mb-1">
            @if (_isEditingName)
            {
                <input type="text" @bind="_nameDraft" @bind:event="oninput"
                       @onkeydown="HandleNameKeyDownAsync"
                       class="flex-1 min-w-0 text-lg font-bold font-headline border-b border-primary bg-transparent focus:outline-none"
                       aria-label="Edit location name" />
                <button type="button" @onclick="SaveNameAsync"
                        class="p-1 rounded hover:bg-surface-container-low transition-colors text-primary flex-shrink-0"
                        aria-label="Save name">
                    <span class="material-symbols-outlined text-base" aria-hidden="true">check</span>
                </button>
                <button type="button" @onclick="CancelNameEdit"
                        class="p-1 rounded hover:bg-surface-container-low transition-colors text-on-surface-variant flex-shrink-0"
                        aria-label="Cancel rename">
                    <span class="material-symbols-outlined text-base" aria-hidden="true">close</span>
                </button>
            }
            else
            {
                <h4 class="text-lg font-bold font-headline flex-1 min-w-0 break-words">@Poi.Name</h4>
                <button type="button" @onclick="BeginNameEdit"
                        class="p-1 rounded hover:bg-surface-container-low transition-colors text-on-surface-variant flex-shrink-0"
                        aria-label="Edit name">
                    <span class="material-symbols-outlined text-base" aria-hidden="true">edit</span>
                </button>
            }
            @* "Use the name from Google Maps" — fills the editor with the place
               name read from the canonical /maps/place/ URL for review. Disabled
               until the POI is enriched (only then is the canonical URL present). *@
            <button type="button" @onclick="UseGoogleMapsName"
                    disabled="@(!CanUseGoogleMapsName)"
                    class="p-1 rounded hover:bg-surface-container-low transition-colors text-on-surface-variant flex-shrink-0 disabled:opacity-40 disabled:cursor-not-allowed"
                    title="@UiStrings.UseGoogleMapsName"
                    aria-label="@UiStrings.UseGoogleMapsName">
                <span class="material-symbols-outlined text-base" aria-hidden="true">travel_explore</span>
            </button>
        </div>
        @if (!string.IsNullOrEmpty(Poi.Address))
        {
            <p class="text-sm text-on-surface-variant mb-3 flex items-start gap-1.5">
                <span class="material-symbols-outlined text-sm mt-0.5 flex-shrink-0">location_on</span>
                @Poi.Address
            </p>
        }

        @* Status, Category & Collection chips. "imported" is an
           internal flag rather than a real status, so we suppress it
           and surface the actual collection memberships instead — the
           user wanted to know which collection a POI belongs to,
           not that it came from a file import. *@
        <div class="flex flex-wrap gap-2 mb-4">
            @if (!string.IsNullOrEmpty(Poi.Status) && Poi.Status != "imported")
            {
                <span class="text-xs px-2.5 py-1 rounded-full font-medium
                    @(Poi.Status switch
                    {
                        "visited" => "bg-secondary/10 text-secondary",
                        "want_to_go" => "bg-primary/10 text-primary",
                        _ => "bg-surface-container-high text-on-surface-variant"
                    })">
                    @Poi.Status.Replace("_", " ")
                </span>
            }
            @if (!string.IsNullOrEmpty(Poi.Category))
            {
                <span class="text-xs px-2.5 py-1 rounded-full bg-surface-container-high text-on-surface-variant">
                    @Poi.Category
                </span>
            }
            @if (CollectionNames is { Count: > 0 })
            {
                @foreach (var name in CollectionNames)
                {
                    <span class="text-xs px-2.5 py-1 rounded-full bg-primary/10 text-primary font-medium">
                        @name
                    </span>
                }
            }
        </div>

        @* Google Rating + Reviews *@
        @if (Poi.GoogleRating.HasValue)
        {
            <div class="flex items-center gap-2 mb-4" role="img" aria-label="@($"Google rating: {Poi.GoogleRating.Value:F1} out of 5 stars")">
                <span class="text-lg font-bold text-on-surface">@Poi.GoogleRating.Value.ToString("F1")</span>
                <div class="flex gap-0.5" aria-hidden="true">
                    @for (var i = 1; i <= 5; i++)
                    {
                        var filled = i <= Math.Round(Poi.GoogleRating.Value);
                        <span class="material-symbols-outlined text-base @(filled ? "text-yellow-500" : "text-surface-container-highest")"
                              style="font-variation-settings: 'FILL' @(filled ? 1 : 0)">
                            star
                        </span>
                    }
                </div>
                @if (Poi.ReviewCount.HasValue)
                {
                    <span class="text-xs text-on-surface-variant">(@Poi.ReviewCount.Value.ToString("N0") reviews)</span>
                }
            </div>
        }

        @* Contact info *@
        @if (!string.IsNullOrEmpty(Poi.Website) || !string.IsNullOrEmpty(Poi.Phone))
        {
            <div class="space-y-2 mb-4">
                @if (!string.IsNullOrEmpty(Poi.Website))
                {
                    <a href="@Poi.Website" target="_blank" rel="noopener"
                       class="flex items-center gap-2 text-sm text-primary hover:underline">
                        <span class="material-symbols-outlined text-base">language</span>
                        @TruncateUrl(Poi.Website)
                    </a>
                }
                @if (!string.IsNullOrEmpty(Poi.Phone))
                {
                    <div class="flex items-center gap-2 text-sm text-on-surface">
                        <span class="material-symbols-outlined text-base text-on-surface-variant">phone</span>
                        @Poi.Phone
                    </div>
                }
            </div>
        }

        @* Personal Rating *@
        @if (Poi.Rating.HasValue)
        {
            <div class="flex items-center gap-2 mb-4" role="img" aria-label="@($"Your rating: {Poi.Rating.Value} out of 5 stars")">
                <span class="text-xs text-on-surface-variant uppercase tracking-wider">Your rating</span>
                <div class="flex gap-0.5" aria-hidden="true">
                    @for (var i = 1; i <= 5; i++)
                    {
                        <span class="material-symbols-outlined text-base @(i <= Poi.Rating.Value ? "text-primary" : "text-surface-container-highest")"
                              style="font-variation-settings: 'FILL' @(i <= Poi.Rating.Value ? 1 : 0)">
                            star
                        </span>
                    }
                </div>
            </div>
        }

        @* Coordinates *@
        <div class="bg-surface-container-low rounded-lg p-3 mb-4">
            <div class="text-xs text-on-surface-variant mb-1">Coordinates</div>
            <div class="font-mono text-sm">@(Poi is { Latitude: not null, Longitude: not null } ? $"{Poi.Latitude.Value:F6}, {Poi.Longitude.Value:F6}" : "—")</div>
        </div>

        @* Notes *@
        @if (!string.IsNullOrEmpty(Poi.Notes))
        {
            <div class="mb-4">
                <div class="text-xs text-on-surface-variant mb-1 uppercase tracking-wider">Notes</div>
                <p class="text-sm">@Poi.Notes</p>
            </div>
        }

        @* Tags (many-to-many via PoiTag join table) *@
        @if (Poi.PoiTags.Any() == true)
        {
            <div class="mb-4">
                <div class="text-xs text-on-surface-variant mb-1 uppercase tracking-wider">Tags</div>
                <div class="flex flex-wrap gap-1">
                    @foreach (var poiTag in Poi.PoiTags)
                    {
                        <span class="text-xs px-2 py-0.5 rounded-full bg-surface-container-high text-on-surface-variant">@poiTag.Tag.Name</span>
                    }
                </div>
            </div>
        }

        @* Dates *@
        <div class="text-xs text-on-surface-variant space-y-1">
            <div>Added: @Poi.AddedDate.ToString("MMMM dd, yyyy")</div>
            @if (Poi.VisitedDate.HasValue)
            {
                <div>Visited: @Poi.VisitedDate.Value.ToString("MMMM dd, yyyy")</div>
            }
        </div>
    </div>

    @* Footer: Enrich + Google Maps buttons *@
    <div class="p-4 flex-shrink-0 space-y-2">
        <button type="button"
                @onclick="HandleEnrichClick"
                disabled="@_enrichRequested"
                aria-label="@UiStrings.EnrichDetailsAria"
                class="flex items-center justify-center gap-2 w-full py-2.5 rounded-lg border border-surface-container-high bg-surface text-on-surface font-medium text-sm hover:bg-surface-container-low transition-all disabled:opacity-50 disabled:cursor-not-allowed">
            <span class="material-symbols-outlined text-base" aria-hidden="true">auto_fix_high</span>
            @(_enrichRequested ? "Queued…" : UiStrings.EnrichDetails)
        </button>
        <button type="button"
                @onclick="HandleManualEnrichClick"
                aria-label="@UiStrings.ManualEnrichAria"
                class="flex items-center justify-center gap-2 w-full py-2.5 rounded-lg border border-surface-container-high bg-surface text-on-surface font-medium text-sm hover:bg-surface-container-low transition-all">
            <span class="material-symbols-outlined text-base" aria-hidden="true">edit_location_alt</span>
            @UiStrings.ManualEnrich
        </button>
        <a href="@PoiUrlHelper.GetGoogleMapsUrl(Poi)"
           target="_blank" rel="noopener"
           class="flex items-center justify-center gap-2 w-full py-2.5 rounded-lg bg-gradient-to-r from-primary to-primary-container text-white font-medium text-sm hover:shadow-lg transition-all">
            <span class="material-symbols-outlined text-base" aria-hidden="true">open_in_new</span>
            @UiStrings.OpenInGoogleMaps
        </a>
    </div>
</div>

@code {
    private const int MaxUrlDisplayLength = 35;

    [Parameter, EditorRequired] public Poi Poi { get; set; } = null!;
    [Parameter] public IReadOnlyList<string>? CollectionNames { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<int> OnEnrichRequested { get; set; }
    [Parameter] public EventCallback<int> OnManualEnrichRequested { get; set; }
    [Parameter] public EventCallback<(int PoiId, string NewName)> OnRenameRequested { get; set; }

    private int _lastSeenPoiId;
    private bool _enrichRequested;

    private bool _isEditingName;
    private string _nameDraft = "";

    // The place name embedded in the canonical Google Maps URL, if any. The
    // "use the Google Maps name" button is only meaningful (and enabled) when
    // the POI is enriched AND such a name can be parsed from its URL.
    private string? _googleMapsName;
    private bool CanUseGoogleMapsName => Poi is { IsEnriched: true } && _googleMapsName is not null;

    protected override void OnParametersSet()
    {
        // The pane renders only when Poi is non-null (parent owns the
        // null check), but bUnit / unit tests do pass Poi=null to verify
        // graceful handling — guard accordingly.
        if (Poi is null)
        {
            return;
        }

        // Reset the queued state when the user opens a different POI, or when
        // the BG service finishes and flips IsEnriched back to true.
        if (Poi.Id != _lastSeenPoiId || Poi.IsEnriched)
        {
            _lastSeenPoiId = Poi.Id;
            _enrichRequested = false;
        }

        // Drop any in-progress rename when the user switches to a different POI.
        if (Poi.Id != _lastEditedPoiId)
        {
            _lastEditedPoiId = Poi.Id;
            _isEditingName = false;
        }

        _googleMapsName = PoiUrlHelper.ExtractPlaceNameFromUrl(Poi.GoogleMapsUrl);
    }

    private int _lastEditedPoiId;

    private void BeginNameEdit()
    {
        _nameDraft = Poi.Name;
        _isEditingName = true;
    }

    private void CancelNameEdit() => _isEditingName = false;

    private void UseGoogleMapsName()
    {
        if (!CanUseGoogleMapsName)
        {
            return;
        }

        // Pre-fill the editor with the Google Maps name so the user can review
        // (and tweak) it before committing, rather than overwriting silently.
        _nameDraft = _googleMapsName!;
        _isEditingName = true;
    }

    private async Task SaveNameAsync()
    {
        var trimmed = _nameDraft?.Trim();
        _isEditingName = false;
        if (string.IsNullOrWhiteSpace(trimmed) || trimmed == Poi.Name)
        {
            return;
        }

        await OnRenameRequested.InvokeAsync((Poi.Id, trimmed));
    }

    private async Task HandleNameKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SaveNameAsync();
        }
        else if (e.Key == "Escape")
        {
            CancelNameEdit();
        }
    }

    private async Task HandleEnrichClick()
    {
        _enrichRequested = true;
        await OnEnrichRequested.InvokeAsync(Poi.Id);
    }

    private Task HandleManualEnrichClick() => OnManualEnrichRequested.InvokeAsync(Poi.Id);

    private static string TruncateUrl(string url)
    {
        try
        {
            var uri = new Uri(url);
            var display = uri.Host + uri.PathAndQuery.TrimEnd('/');
            return display.Length > MaxUrlDisplayLength ? display[..MaxUrlDisplayLength] + "..." : display;
        }
        catch
        {
            url = url.Replace("https://", "").Replace("http://", "").TrimEnd('/');
            return url.Length > MaxUrlDisplayLength ? url[..MaxUrlDisplayLength] + "..." : url;
        }
    }
}
