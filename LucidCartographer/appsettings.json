{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Polly": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Password": "",
    "PasswordHash": ""
  },
  "Database": {
    "Path": "data/cartographer.db"
  },
  "Coravel": {
    "Queue": {
      "ConsummationDelay": 1
    }
  },
  "Enrichment": {
    "Concurrency": 4,
    "MaxConcurrentPages": 8,
    "BatchSize": 16,
    "IdlePollSeconds": 30,
    "MaxRetries": 5,
    "BackoffBaseSeconds": 30
  }
}
