# Copy this file to .env and fill in the values before running docker compose.
# NEVER commit the .env file to version control.

# Initial admin password. Required only on the FIRST run, when the user database
# is empty — it seeds the "admin" account. Startup fails fast if it is blank and
# no users exist yet. Can be left blank on subsequent runs.
ADMIN_PASSWORD=

# API key remote clients (e.g. Claude Code) must send to use the /mcp endpoint,
# as "Authorization: Bearer <key>" or "X-Api-Key: <key>". Leave blank to disable
# remote MCP access (fail-closed). In Production the loopback/LAN bypass is off,
# so this key is required from every origin.
MCP_API_KEY=

# Public https base URL this app is reachable at (e.g. https://maps.example.com).
# Set it to enable the OAuth frontdoor, which lets Claude.ai connectors sign in
# (browserless, self-registering). Leave blank to keep /mcp on MCP_API_KEY only.
# When set behind the tunnel, also set the tunnel's source IP in Auth:TrustedProxies
# (e.g. Auth__TrustedProxies__0=172.18.0.1) so forwarded https is trusted.
PUBLIC_URL=
