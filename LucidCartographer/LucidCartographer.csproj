<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Re-declared here (not only in Directory.Build.props) because the Docker
         build context excludes the parent props file. Keep LangVersion in sync
         with Directory.Build.props and the Dockerfile build-stage SDK: C# 14
         needs the .NET 10 SDK even though the app targets net8.0. -->
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Suppresses NavigationException in Blazor Server to prevent enhanced-nav
         redirects from surfacing as unhandled exceptions in middleware (e.g. auth). -->
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Coravel" Version="6.0.2" />
    <PackageReference Include="CsvHelper" Version="33.0.1" />
    <PackageReference Include="Fastenshtein" Version="1.0.10" />
    <PackageReference Include="Geolocation" Version="1.2.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.27">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.27" />
    <PackageReference Include="Microsoft.Playwright" Version="1.49.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.3.0" />
    <PackageReference Include="OpenIddict.AspNetCore" Version="7.5.0" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="7.5.0" />
    <PackageReference Include="NetTopologySuite.IO.GeoJSON" Version="4.0.0" />
    <PackageReference Include="NetTopologySuite.IO.GPX" Version="1.1.1" />
    <PackageReference Include="Polly" Version="8.5.0" />
    <PackageReference Include="Polly.Extensions" Version="8.5.0" />
    <PackageReference Include="Polly.RateLimiting" Version="8.5.0" />
    <PackageReference Include="SharpKml.Core" Version="6.1.0" />
    <PackageReference Include="System.Linq.Async" Version="6.0.1" />
    <PackageReference Include="System.Reactive" Version="6.0.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LucidCartographer.Tests" />
  </ItemGroup>

  <!-- The in-app operator guide served by DocsEndpoints (/docs/osrm.md, the Trip View
       "How to enable OSRM" link). Embedded into the assembly so it is present at runtime
       on every host: a wwwroot .md is unserved (unknown content type) AND stripped from
       the Docker image (.dockerignore excludes *.md, with a negation for this one file). -->
  <ItemGroup>
    <EmbeddedResource Include="Endpoints\Docs\osrm.md" />
  </ItemGroup>

  <!--
    Tailwind CSS compile step for local `dotnet run`.
    The Dockerfile already does this during image build; this target makes
    sure a fresh checkout outside Docker doesn't ship an unstyled app
    because wwwroot/css/tailwind.css (which is gitignored as a build
    artifact) isn't present. Downloads the pinned standalone CLI into obj/
    on first build — no Node.js required. Keep the version in sync with
    the Dockerfile.
  -->
  <PropertyGroup>
    <TailwindVersion>v3.4.17</TailwindVersion>
    <TailwindInput>$(MSBuildProjectDirectory)/wwwroot/css/input.css</TailwindInput>
    <TailwindOutput>$(MSBuildProjectDirectory)/wwwroot/css/tailwind.css</TailwindOutput>
    <TailwindBinaryDir>$(MSBuildProjectDirectory)/obj/tailwindcss</TailwindBinaryDir>
    <TailwindBinaryName Condition="$([MSBuild]::IsOSPlatform('Windows'))">tailwindcss-windows-x64.exe</TailwindBinaryName>
    <TailwindBinaryName Condition="$([MSBuild]::IsOSPlatform('Linux'))">tailwindcss-linux-x64</TailwindBinaryName>
    <TailwindBinaryName Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">tailwindcss-macos-arm64</TailwindBinaryName>
    <TailwindBinaryName Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' != 'Arm64'">tailwindcss-macos-x64</TailwindBinaryName>
    <TailwindBinaryPath>$(TailwindBinaryDir)/$(TailwindBinaryName)</TailwindBinaryPath>
    <TailwindDownloadUrl>https://github.com/tailwindlabs/tailwindcss/releases/download/$(TailwindVersion)/$(TailwindBinaryName)</TailwindDownloadUrl>
  </PropertyGroup>

  <Target Name="EnsureTailwindBinary" Condition="!Exists('$(TailwindBinaryPath)')">
    <MakeDir Directories="$(TailwindBinaryDir)" />
    <Message Importance="high" Text="Downloading Tailwind CLI $(TailwindVersion) ($(TailwindBinaryName))..." />
    <DownloadFile SourceUrl="$(TailwindDownloadUrl)" DestinationFolder="$(TailwindBinaryDir)" />
    <Exec Command="chmod +x &quot;$(TailwindBinaryPath)&quot;" Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
  </Target>

  <Target Name="CompileTailwindCss" BeforeTargets="BeforeBuild" DependsOnTargets="EnsureTailwindBinary" Inputs="$(TailwindInput);tailwind.config.js;@(Content);@(None)" Outputs="$(TailwindOutput)">
    <Message Importance="high" Text="Compiling Tailwind CSS: $(TailwindInput) -&gt; $(TailwindOutput)" />
    <Exec Command="&quot;$(TailwindBinaryPath)&quot; -i &quot;$(TailwindInput)&quot; -o &quot;$(TailwindOutput)&quot; --minify" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

</Project>
