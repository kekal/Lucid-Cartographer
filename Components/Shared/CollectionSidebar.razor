@using LucidCartographer.Data.Entities

<div class="flex flex-col h-full">
    <div class="p-4 flex-shrink-0">
        <h3 class="text-xs font-semibold text-on-surface-variant uppercase tracking-wider mb-1">Collections</h3>
    </div>

    <div class="flex-1 overflow-y-auto px-2" role="listbox" aria-label="Collection list">
        @if (Collections == null || !Collections.Any())
        {
            <div class="px-2 py-4 text-center text-sm text-on-surface-variant">
                <p>No collections yet.</p>
                <p class="text-xs mt-1">Import data via Data Sources tab.</p>
            </div>
        }
        else
        {
            @foreach (var col in Collections)
            {
                <div @key="col.Id"
                     class="flex items-center gap-2 px-2 py-2 rounded-lg cursor-pointer transition-colors
                            @(SelectedCollectionId == col.Id ? "bg-surface-container-high" : "hover:bg-surface-container-low")"
                     role="option"
                     aria-selected="@(SelectedCollectionId == col.Id)"
                     tabindex="0"
                     @onclick="() => HandleCollectionClick(col.Id)"
                     @onkeydown="(e) => HandleKeyDown(e, col.Id)">
                    <div class="w-3 h-3 rounded-full flex-shrink-0" style="background-color: @col.Color"
                         aria-hidden="true"></div>
                    <div class="flex-1 min-w-0">
                        <div class="text-sm font-medium truncate">@col.Name</div>
                    </div>
                    <span class="text-xs text-on-surface-variant flex-shrink-0">@col.PoiCount</span>
                    <button class="p-0.5 rounded hover:bg-surface-container-highest transition-colors flex-shrink-0"
                            aria-label="@($"Toggle visibility for {col.Name}")"
                            @onclick:stopPropagation="true"
                            @onclick="() => HandleVisibilityClick(col.Id)">
                        <span class="material-symbols-outlined text-base text-on-surface-variant"
                              style="font-variation-settings: 'FILL' @(col.IsVisible ? 1 : 0)"
                              aria-hidden="true">
                            visibility
                        </span>
                        <span class="sr-only">@(col.IsVisible ? "Visible" : "Hidden")</span>
                    </button>
                </div>
            }
        }
    </div>
</div>

@code {
    // HIGH-01: Accept IReadOnlyList to prevent mutation by children
    // MED-06: Use EditorRequired on mandatory parameters
    [Parameter, EditorRequired] public IReadOnlyList<PoiCollection> Collections { get; set; } = Array.Empty<PoiCollection>();
    [Parameter] public int? SelectedCollectionId { get; set; }
    [Parameter] public EventCallback<int> OnCollectionSelected { get; set; }
    [Parameter] public EventCallback<int> OnVisibilityToggled { get; set; }

    // MED-10: Wrap EventCallback invocations in code-behind methods with try/catch
    private async Task HandleCollectionClick(int collectionId)
    {
        try
        {
            await OnCollectionSelected.InvokeAsync(collectionId);
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error selecting collection {collectionId}: {ex.Message}");
        }
    }

    private async Task HandleVisibilityClick(int collectionId)
    {
        try
        {
            await OnVisibilityToggled.InvokeAsync(collectionId);
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error toggling visibility for collection {collectionId}: {ex.Message}");
        }
    }

    // LOW-01: Keyboard navigation support
    private async Task HandleKeyDown(KeyboardEventArgs e, int collectionId)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            await HandleCollectionClick(collectionId);
        }
    }
}
