@using LucidCartographer.Services

<div class="mb-4 p-4 rounded-lg bg-primary/5">
    <h4 class="font-bold text-sm mb-2 flex items-center gap-2">
        <span class="material-symbols-outlined text-primary text-base">link</span>
        Paste a Google Maps list URL
    </h4>
    <p class="text-sm text-on-surface-variant mb-3">
        Works with shared lists, your own lists, or any Google Maps list URL. The app will open it in a headless browser and extract all places automatically.
    </p>
    <div class="flex gap-2">
        <input type="text" @bind="Url" placeholder="https://maps.app.goo.gl/... or https://www.google.com/maps/..."
               class="flex-1 px-3 py-2 rounded-lg bg-surface-container-highest border-0 text-on-surface placeholder:text-outline text-sm focus:ring-2 focus:ring-primary focus:bg-white transition-colors" />
        <button class="px-4 py-2 rounded-lg bg-gradient-to-r from-primary to-primary-container text-white text-sm font-medium hover:shadow-lg transition-all flex items-center gap-2 flex-shrink-0"
                @onclick="HandleScrape"
                disabled="@(IsScraping || string.IsNullOrWhiteSpace(Url))">
            @if (IsScraping)
            {
                <div class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                <span>Scraping...</span>
            }
            else
            {
                <span class="material-symbols-outlined text-base">download</span>
                <span>Import</span>
            }
        </button>
    </div>
    @if (ScrapeProgress > 0 && IsScraping)
    {
        <p class="text-xs text-on-surface-variant mt-2" aria-live="polite">
            <span class="material-symbols-outlined text-xs align-middle">hourglass_top</span>
            Scrolling list... @ScrapeProgress places found so far
        </p>
    }
</div>

@code {
    [Parameter] public string Url { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> UrlChanged { get; set; }
    [Parameter] public bool IsScraping { get; set; }
    [Parameter] public int ScrapeProgress { get; set; }
    [Parameter] public EventCallback OnScrape { get; set; }

    private async Task HandleScrape()
    {
        await OnScrape.InvokeAsync();
    }
}
